# Standalone chat-redis (infra/docker/chat-redis/standalone.yml).
# Copy to infra/docker/chat-redis/.env when running standalone, or reuse
# a stack's own env file; only the datastore connection vars below matter
# there. See infra/docker/redis/standalone.yml (generic 6379) for the same
# pattern.
COMPOSE_PROJECT_NAME=detect_ai_chat_redis

REDIS_PASSWORD=chat_redis_password
CHAT_REDIS_PORT=6381

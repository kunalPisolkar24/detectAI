# Standalone redis-chat (infra/docker/redis-chat/standalone.yml).
# Copy to infra/docker/redis-chat/.env when running standalone, or reuse
# a stack's own env file; only the datastore connection vars below matter
# there. See infra/docker/redis-users/standalone.yml (generic 6379) for the same
# pattern.
COMPOSE_PROJECT_NAME=detect_ai_redis_chat

REDIS_CHAT_PASSWORD=chat_redis_password
REDIS_CHAT_PORT=6381

# Standalone data layer (infra/docker/data/compose.yml).
# Aggregate of postgres + redis-cache (+ optional rabbitmq) atoms.
# Paddle-only events-redis is NOT included here; see
# infra/docker/redis-events/.env.example for its knobs.
# Copy to infra/docker/data/.env when running it directly, or reuse
# infra/docker/local/.env (same variable names). Per-atom examples live at
# infra/docker/postgres/.env.example, infra/docker/redis/.env.example and
# infra/docker/rabbitmq/.env.example; this file aggregates them so one env
# serves the bundle. Importing stacks (e.g. apps/web `make start`) supply
# values via their own env file; only the datastore connection vars below
# matter there.
COMPOSE_PROJECT_NAME=detect_ai_data

POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=detect_ai
POSTGRES_PORT=5432

REDIS_PASSWORD=user_cache_password
REDIS_PORT=6379

RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672

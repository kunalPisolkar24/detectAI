# Standalone data layer (infra/docker/data/compose.yml).
# Copy to infra/docker/data/.env when running it directly, or reuse
# infra/docker/local/.env (same variable names). Importing stacks
# (e.g. apps/web `make start WITH_DATA=1`) supply values via their own
# env file; only the datastore connection vars below matter there.
COMPOSE_PROJECT_NAME=detect_ai_data

POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=detect_ai
POSTGRES_PORT=5432

REDIS_PASSWORD=user_cache_password
REDIS_PORT=6379

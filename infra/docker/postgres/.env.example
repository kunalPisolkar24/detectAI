# Standalone postgres (infra/docker/postgres/standalone.yml).
# Copy to infra/docker/postgres/.env when running standalone, or reuse
# infra/docker/data/.env (same variable names). Importing stacks
# (e.g. apps/web `make start`) supply values via their own env file;
# only the datastore connection vars below matter there. See
# infra/docker/redis/standalone.yml and infra/docker/rabbitmq/standalone.yml
# for the same pattern.
COMPOSE_PROJECT_NAME=detect_ai_postgres

POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=detect_ai
POSTGRES_PORT=5432

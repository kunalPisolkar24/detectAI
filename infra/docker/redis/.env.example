# Standalone redis (infra/docker/redis/standalone.yml).
# Copy to infra/docker/redis/.env when running standalone, or reuse
# infra/docker/data/.env (same variable names). Importing stacks
# (e.g. apps/web `make start`) supply values via their own env file;
# only the datastore connection vars below matter there. See
# infra/docker/postgres/standalone.yml and infra/docker/rabbitmq/standalone.yml
# for the same pattern.
COMPOSE_PROJECT_NAME=detect_ai_redis

REDIS_PASSWORD=user_cache_password
REDIS_PORT=6379

# Standalone mongo (infra/docker/mongo/standalone.yml).
# Copy to infra/docker/mongo/.env when running standalone, or reuse
# infra/docker/data/.env (same variable names). Importing stacks
# (e.g. services/chats `make up`) supply values via their own env file;
# only the datastore connection vars below matter there. See
# infra/docker/redis/standalone.yml and infra/docker/postgres/standalone.yml
# for the same pattern.
COMPOSE_PROJECT_NAME=detect_ai_mongo

MONGO_PORT=27017

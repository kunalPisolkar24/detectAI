# Local stack env (infra/docker/local/compose.yml, ENV_TYPE=dev).
# Copy to infra/docker/local/.env and adjust secrets:
#   cp infra/docker/local/.env.example infra/docker/local/.env   # from repo root
# Shell-exported vars win over this file. Never commit .env (gitignored).
#
# Only wiring (URLs, passwords, ports, secrets) is set here. Performance
# tunables are left empty so each service falls back to its own defaults
# (setting one shared BATCH_SIZE/PORT would hit unrelated services).

ENV_TYPE=dev

# -- postgres-users (all except chats/inference/doc-parser) ------------------
# Standalone single instance; REPLICA == primary (prod: Aurora reader).
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=detect_ai
POSTGRES_PORT=5432
DATABASE_URL=postgresql://user:password@postgres-users:5432/detect_ai
DATABASE_URL_REPLICA=postgresql://user:password@postgres-users:5432/detect_ai

# -- redis-users (web + workers: cache + rate-limit + analytics dedup) -------
REDIS_URL=redis://:user_cache_password@redis-users:6379
REDIS_PASSWORD=user_cache_password
REDIS_PORT=6379

# -- redis-chat (chats streams + cache; own password, NOT REDIS_PASSWORD) ----
REDIS_CHAT_PASSWORD=test_redis_password
REDIS_CHAT_PORT=6381
CHAT_REDIS_ADDR=redis-chat:6379
# CHAT_REDIS_URL=  # optional full URL; empty = use CHAT_REDIS_ADDR

# -- redis-events (Paddle-only dedup; remapped to 6382, see compose.yml) -----
EVENT_REDIS_URL=redis://:events_password@redis-events:6379
EVENT_REDIS_PASSWORD=events_password
EVENT_REDIS_PORT=6382

# -- mongo-chat ---------------------------------------------------------------
MONGO_URI=mongodb://mongo-chat:27017
MONGO_DATABASE=chat_db
MONGO_MODE=standalone
MONGO_TLS_ENABLED=false
MONGO_CHAT_PORT=27018

# -- rabbitmq (gateway + workers; UI at http://localhost:15672) --------------
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672
RABBITMQ_QUEUE_TYPE=quorum
RABBITMQ_PREFETCH=1

# -- web frontend --------------------------------------------------------------
PORT_FRONTEND=3000
NODE_ENV=production
LOG_LEVEL=info
DB_POOL_MAX=5
NEXTAUTH_SECRET=change-me-to-a-random-32-char-string
NEXTAUTH_URL=http://localhost:3000
GITHUB_ID=mock-github-client-id-not-configured
GITHUB_SECRET=mock-github-client-secret-not-configured
GOOGLE_ID=mock-google-client-id-not-configured
GOOGLE_SECRET=mock-google-client-secret-not-configured
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x00000000000000000000AA
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=mock-paddle-client-token-not-configured
NEXT_PUBLIC_ENV_TYPE=dev
NEXT_PUBLIC_PREVIEW_MODE=false
PAYMENT_GATEWAY_URL=http://payment-gateway:8080
INTERNAL_API_KEY=change-me-16chars-min
AI_SERVICE_URL=ai-service:50051
AI_SERVICE_API_KEY=dev-secret-key-16chars-at-least
CHAT_SERVICE_URL=chat-service:50051
FILE_EXTRACTOR_API_URL=http://document-parser:8000
# PROMETHEUS_WEB_SCRAPE_TOKEN=
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_SERVICE_NAME=  # empty = each service uses its own default

# -- payments gateway -----------------------------------------------------------
PORT_GATEWAY=8080
PADDLE_WEBHOOK_SECRET=change-me-16chars-min
GIN_MODE=release

# -- workers ---------------------------------------------------------------------
WORKER_ANALYTICS_PORT=7001
WORKER_CRON_PORT=7002
WORKER_PAYMENTS_PORT=7003
PADDLE_API_KEY=mock-paddle-api-key-not-configured
PADDLE_ENVIRONMENT=sandbox
CRON_CHECK_INTERVAL_MS=900000
CRON_BATCH_SIZE=100

# -- inference (CPU image; API_KEY must match AI_SERVICE_API_KEY above) --------
GRPC_PORT=50051
METRICS_PORT=8333
API_KEY=dev-secret-key-16chars-at-least
INFERENCE_PROVIDERS=CPUExecutionProvider
# MODEL_CACHE_DIR=  # empty = ./models inside container
# HF_TOKEN=         # only for private HF repos
# SPARK_MODEL_REVISION=
# FLARE_MODEL_REVISION=

# -- document parser (container listens on 8000; knob below is host-only) ------
DOC_PARSER_PORT=8000

# -- chats (container ports fixed; knobs below are host-only) --------------------
CHAT_GRPC_HOST_PORT=50052
CHAT_METRICS_HOST_PORT=9095
CHAT_WORKER_METRICS_PORT_HOST=9099

COMPOSE_PROJECT_NAME=detect_ai_local
NODE_ENV=production
LOG_LEVEL=debug
HOSTNAME=0.0.0.0

POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=detect_ai
POSTGRES_PORT=5432
DATABASE_URL=postgresql://user:password@postgres:5432/detect_ai
DATABASE_URL_REPLICA=postgresql://user:password@postgres:5432/detect_ai

REDIS_PASSWORD=user_cache_password
REDIS_MODE=standalone
REDIS_PORT=6379
REDIS_USAGE_PORT=6382
REDIS_URL=redis://:user_cache_password@redis-app:6379
REDIS_SENTINELS=redis-app:26379
REDIS_MASTER_NAME=mymaster
REDIS_USAGE_MODE=standalone
REDIS_USAGE_PASSWORD=usage_cache_password
REDIS_USAGE_URL=redis://:usage_cache_password@redis-usage:6379
USE_REDIS_CLUSTER=false

RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
RABBITMQ_QUEUE_TYPE=classic

PORT_FRONTEND=3000
PORT_GATEWAY=8080
PORT_DOC_PARSER=8000
PORT_INFERENCE=50051
PORT_INFERENCE_METRICS=8333

FILE_EXTRACTOR_API_URL=http://document-parser:8000
AI_SERVICE_URL=ai-service:50051
CHAT_SERVICE_URL=chat-service:50051
PAYMENT_GATEWAY_URL=http://payment-gateway:8080

AI_SERVICE_API_KEY=dev-secret-key
INTERNAL_API_KEY=internal-secret-key

NEXTAUTH_SECRET=my_auth_secret
NEXTAUTH_URL=http://localhost:3000/
GITHUB_ID=
GITHUB_SECRET=
GOOGLE_ID=
GOOGLE_SECRET=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

PADDLE_API_KEY=
PADDLE_ENVIRONMENT=sandbox
PADDLE_WEBHOOK_SECRET=
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=

DOC_PARSER_WORKERS=2
DOC_PARSER_API_TITLE=File Processing Service
DOC_PARSER_API_VERSION=1.0.0
DOC_PARSER_MAX_UPLOAD_SIZE=10485760
DOC_PARSER_MAX_TEXT_LENGTH=1000000

GIN_MODE=release

CHAT_APP_ENV=development
CHAT_GRPC_PORT=:50051
CHAT_METRICS_PORT=:9091
CHAT_WORKER_METRICS_PORT=:9099
CHAT_MONGO_URI=mongodb://chat-mongo:27017
CHAT_MONGO_DB=chat_db
CHAT_REDIS_MODE=standalone
CHAT_REDIS_ADDRS=redis-chat:6379
CHAT_REDIS_POOL_SIZE=25
CHAT_WORKER_CONCURRENCY=2
CHAT_STREAM_PARTITION_COUNT=4
CHAT_CACHE_TTL=24h
CHAT_BATCH_SIZE=25

INFERENCE_BATCH_SIZE=8
INFERENCE_BATCH_TIMEOUT=0.05
INFERENCE_MAX_TEXT_CHARS=50000
INFERENCE_BATCH_QUEUE_MAX_SIZE=1024
INFERENCE_MAX_INFLIGHT_DOC_CHUNKS=8
INFERENCE_CHUNK_TOKEN_LIMIT=256
INFERENCE_CHUNK_TOKEN_STRIDE=192
INFERENCE_MODEL_CACHE_DIR=/app/models
INFERENCE_PROVIDERS=CPUExecutionProvider

WORKER_ANALYTICS_PORT=7001
WORKER_CRON_PORT=7002
WORKER_PAYMENTS_PORT=7003

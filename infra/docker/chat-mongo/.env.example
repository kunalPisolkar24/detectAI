# Standalone chat-mongo (infra/docker/chat-mongo/standalone.yml).
# Copy to infra/docker/chat-mongo/.env when running standalone, or reuse
# a stack's own env file; only the datastore connection vars below matter
# there. See infra/docker/mongo/standalone.yml (generic 27017) and
# infra/docker/redis/standalone.yml for the same pattern.
COMPOSE_PROJECT_NAME=detect_ai_chat_mongo

CHAT_MONGO_PORT=27018

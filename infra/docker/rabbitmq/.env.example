# Standalone RabbitMQ (infra/docker/rabbitmq/standalone.yml).
# Copy to infra/docker/rabbitmq/.env when running standalone, or reuse
# infra/docker/data/.env (same variable names). Importing stacks
# (e.g. services/payments/gateway `make gateway-up`) supply values via
# their own env file; only the connection/credential vars below matter
# there. See infra/docker/postgres/standalone.yml and
# infra/docker/redis/standalone.yml for the same pattern.
COMPOSE_PROJECT_NAME=detect_ai_rabbitmq

RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672

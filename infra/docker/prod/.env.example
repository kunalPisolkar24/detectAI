# Prod stack env (infra/docker/prod/compose.yml, ENV_TYPE=prod).
# Copy to infra/docker/prod/.env and fill the secrets:
#   cp infra/docker/prod/.env.example infra/docker/prod/.env   # from repo root
# Shell-exported vars win over this file. Never commit .env (gitignored).
#
# Two kinds of values:
#   1. Runtime-fetched from Floci/AWS (URLs, passwords) — leave empty here,
#      containers hydrate via Secrets Manager + SSM at boot.
#   2. Must be set here — DATABASE_URL* (db-migrate is plain Prisma, workers
#      only fetch RABBITMQ_URL/PADDLE_* from AWS), build-time NEXT_PUBLIC_*,
#      and shared secrets that must match across services (marked MATCH below).
#
# Floci-first flow (http://localhost:4566 on the host):
#   terraform -chdir=infra/terraform apply -var-file=envs/floci-local.tfvars
#   make floci-seed
#   terraform -chdir=infra/terraform output -raw database_url  # -> paste below
# For real AWS: set AWS_ENDPOINT_URL empty and flip the TLS vars to true /
# sslmode=require (see bottom).

ENV_TYPE=prod
AWS_REGION=ap-south-1
# In-container route to the emulator (host's localhost:4566). Empty = real AWS.
AWS_ENDPOINT_URL=http://host.docker.internal:4566
# Static AWS keys: leave UNSET (compose does not pass them at all). Every
# service auto-injects test/test when the endpoint is Floci; setting them to
# an empty value would BREAK Floci auth for the Go services (LookupEnv).
# Real AWS uses task/instance roles, not these vars.
SSM_ENABLED=true

# -- Terraform secret names (defaults match infra/terraform modules) -----------
PG_URLS_SECRET_NAME=detectai/pg/urls
DOCDB_URLS_SECRET_NAME=detectai/docdb/urls
REDIS_USERS_URLS_SECRET_NAME=detectai/redis/users/urls
REDIS_URLS_SECRET_NAME=detectai/redis/users/urls
MQ_URLS_SECRET_NAME=detectai/mq/urls
MQ_SECRETS_NAME=detectai/mq/urls
WEB_SECRETS_NAME=detectai/web/secrets
WORKERS_SECRETS_NAME=detectai/workers/secrets
GATEWAY_SECRETS_NAME=detectai/gateway/secrets
INFERENCE_SECRETS_NAME=detectai/inference/secrets
DOCUMENT_PARSER_SECRETS_NAME=detectai/document-parser/secrets

# -- SSM prefixes (one per service; env wins over SSM) --------------------------
WEB_SSM_PREFIX=/detectai/web/
WORKERS_SSM_PREFIX=/detectai/workers/
GATEWAY_SSM_PREFIX=/detectai/gateway/
CHAT_SSM_PREFIX=/detectai/chat/
INFERENCE_SSM_PREFIX=/detectai/inference/
DOC_PARSER_SSM_PREFIX=/detectai/document-parser/

# -- Postgres URLs: REQUIRED here (see header). ---------------------------------
# Fill from Floci outputs; rewrite the host to host.docker.internal if the
# emitted endpoint is localhost (containers can't dial host localhost):
#   terraform -chdir=infra/terraform output -raw database_url
#   terraform -chdir=infra/terraform output -raw database_url_replica
DATABASE_URL=postgresql://dbadmin:REPLACE_ME@host.docker.internal:REFER_TF_OUTPUT/detect_ai?sslmode=disable
DATABASE_URL_REPLICA=postgresql://dbadmin:REPLACE_ME@host.docker.internal:REFER_TF_OUTPUT/detect_ai?sslmode=disable

# -- Redis URLs: Floci vs real AWS differ — read this. ---------------------------
# Floci's valkey backing stores have STABLE container hostnames on
# $FLOCI_NETWORK but (a) run WITHOUT password, (b) TF secrets say
# localhost:638x (unreachable/unbound from containers). So for Floci runs,
# override with the passwordless hostname URLs below. On real AWS leave them
# empty (ElastiCache enforces the TF secret passwords).
# NOTE: Floci + passwordless redis vs apps sending the TF secret password is
# a known emulator gap — see "Floci redis auth" note in compose.floci.yml
# header / README. If chats/workers fail AUTH on Floci, that is why.
REDIS_URL=redis://floci-valkey-detectai-redis-users-local:6379
REDIS_PASSWORD=
EVENT_REDIS_URL=redis://floci-valkey-detectai-redis-events-local:6379
EVENT_REDIS_PASSWORD=
# Chats honors CHAT_REDIS_ADDR (host:port, no scheme).
CHAT_REDIS_ADDR=floci-valkey-detectai-redis-chat-local:6379
# CHATS_REDIS_URL=      # full URL override for chats only (rarely needed)
# CHATS_REDIS_PASSWORD= # empty = TF secret detectai/redis/chat/urls
RABBITMQ_URL=
RABBITMQ_PREFETCH=1
RABBITMQ_QUEUE_TYPE=quorum

# -- web frontend ----------------------------------------------------------------
PORT_FRONTEND=3000
NODE_ENV=production
LOG_LEVEL=info
DB_POOL_MAX=5
NEXTAUTH_URL=http://localhost:3000
# Empty = fetched from detectai/web/secrets on Floci (make floci-seed).
NEXTAUTH_SECRET=
GITHUB_ID=
GITHUB_SECRET=
GOOGLE_ID=
GOOGLE_SECRET=
TURNSTILE_SECRET_KEY=
# Build-time public vars (baked at `next build`; real values needed for prod).
NEXT_PUBLIC_ENV_TYPE=prod
NEXT_PUBLIC_PREVIEW_MODE=false
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
# Inter-service URLs (compose DNS).
PAYMENT_GATEWAY_URL=http://payment-gateway:8080
AI_SERVICE_URL=ai-service:50051
CHAT_SERVICE_URL=chat-service:50051
FILE_EXTRACTOR_API_URL=http://document-parser:8000
# Shared secrets: empty = fetched from Floci secrets (single source of truth).
# `make floci-seed` generates ONE random value per key and stores it in every
# secret that needs it (web + gateway + inference stay in sync). Only set
# these here if you deliberately want env to override the secrets.
INTERNAL_API_KEY=
AI_SERVICE_API_KEY=
# PROMETHEUS_WEB_SCRAPE_TOKEN=

# -- payments gateway --------------------------------------------------------------
PORT_GATEWAY=8080
GIN_MODE=release
# Empty = detectai/gateway/secrets (seeded). Env wins if set.
PADDLE_WEBHOOK_SECRET=

# -- workers ------------------------------------------------------------------------
WORKER_ANALYTICS_PORT=7001
WORKER_CRON_PORT=7002
WORKER_PAYMENTS_PORT=7003
PADDLE_API_KEY=
PADDLE_ENVIRONMENT=sandbox
CRON_CHECK_INTERVAL_MS=900000
CRON_BATCH_SIZE=100

# -- inference (GPU image; API_KEY empty = detectai/inference/secrets) -----------
GRPC_PORT=50051
METRICS_PORT=8333
API_KEY=
INFERENCE_PROVIDERS=CUDAExecutionProvider,CPUExecutionProvider
# No-GPU Floci box? Temporarily use CPUExecutionProvider here AND swap the
# compose build to Dockerfile.local for that run (needs rebuild).
# HF_TOKEN=  # via detectai/inference/secrets for private HF repos

# -- document parser (container listens on 8000; knob below is host-only) --------
DOC_PARSER_PORT=8000

# -- chats (empty = Floci secrets; Floci values shown for reference) --------------
# MONGO_URI=            # else detectai/docdb/urls {MONGO_URI,...}
# MONGO_DATABASE=chat_db
MONGO_MODE=standalone
MONGO_TLS_ENABLED=false
# CHAT_REDIS_ADDR=      # else detectai/redis/chat/urls {CHAT_REDIS_ADDR,...}
# REDIS_TLS_ENABLED=false
CHAT_GRPC_HOST_PORT=50052
CHAT_METRICS_HOST_PORT=9095
CHAT_WORKER_METRICS_PORT_HOST=9099

# -- real AWS (prod.tfvars) flips ----------------------------------------------------
# AWS_ENDPOINT_URL=            # empty: real AWS endpoints
# MONGO_TLS_ENABLED=true
# REDIS_TLS_ENABLED=true
# DATABASE_URL=?sslmode=require (from real TF output)

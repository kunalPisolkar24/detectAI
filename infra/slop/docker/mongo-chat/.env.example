# Standalone mongo-chat (infra/docker/mongo-chat/standalone.yml).
# Copy to infra/docker/mongo-chat/.env when running standalone, or reuse
# a stack's own env file; only the datastore connection vars below matter
# there. See infra/docker/redis-chat/standalone.yml for the same pattern.
COMPOSE_PROJECT_NAME=detect_ai_mongo_chat

MONGO_CHAT_PORT=27018

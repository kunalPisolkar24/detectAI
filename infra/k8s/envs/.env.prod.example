# =============================================================
# Detect AI — Kubernetes Production Environment
# Copy this file to .env.prod and fill in all values.
# Variables prefixed with K8S_IMAGE_ are used by the deploy
# script only and are NOT injected into running pods.
# =============================================================

# ---- General ------------------------------------------------
NODE_ENV=production
LOG_LEVEL=warn
HOSTNAME=

# ---- Postgres -----------------------------------------------
POSTGRES_USER=detect_ai
POSTGRES_PASSWORD=
POSTGRES_DB=detect-ai
POSTGRES_PORT=5432
DATABASE_URL=postgresql://detect_ai:password@detect-ai-postgres:5432/detect-ai
DATABASE_URL_REPLICA=postgresql://detect_ai:password@detect-ai-postgres:5432/detect-ai

# ---- Redis --------------------------------------------------
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_URL=redis://:password@detect-ai-redis-usercache:6379
REDIS_MODE=sentinel
REDIS_MASTER_NAME=mymaster
REDIS_SENTINELS=detect-ai-redis-usercache:26379
REDIS_USAGE_URL=redis://:password@detect-ai-redis-usage:6379
REDIS_USAGE_MODE=standalone
REDIS_USAGE_PASSWORD=
EVENT_REDIS_URL=redis://:password@detect-ai-redis-events:6379
EVENT_REDIS_MODE=standalone
EVENT_REDIS_PASSWORD=

# ---- RabbitMQ -----------------------------------------------
RABBITMQ_USER=detect_ai
RABBITMQ_PASS=
RABBITMQ_DEFAULT_USER=detect_ai
RABBITMQ_DEFAULT_PASS=
RABBITMQ_PORT=5672
RABBITMQ_URL=amqp://detect_ai:password@detect-ai-rabbitmq:5672
RABBITMQ_QUEUE_TYPE=quorum

# ---- Web App — Auth & Providers ----------------------------
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://detect-ai.local
GITHUB_ID=
GITHUB_SECRET=
GOOGLE_ID=
GOOGLE_SECRET=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- Payments (Paddle) -------------------------------------
PADDLE_API_KEY=
PADDLE_ENVIRONMENT=production
PADDLE_WEBHOOK_SECRET=
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=

# ---- API Keys & Secrets ------------------------------------
AI_SERVICE_API_KEY=
INTERNAL_API_KEY=

# ---- Service Ports -----------------------------------------
PORT_FRONTEND=3000
PORT_GATEWAY=8080
PORT_DOC_PARSER=8000
PORT_INFERENCE=50051
PORT_INFERENCE_METRICS=8333

# ---- Document Parser ---------------------------------------
DOC_PARSER_WORKERS=4
DOC_PARSER_API_TITLE=Detect AI Document Parser
DOC_PARSER_API_VERSION=1.0.0
DOC_PARSER_MAX_UPLOAD_SIZE=10485760
DOC_PARSER_MAX_TEXT_LENGTH=50000

# ---- Payment Gateway ---------------------------------------
GIN_MODE=release

# ---- Chat Service ------------------------------------------
CHAT_APP_ENV=production
APP_ENV=production
CHAT_SERVICE_API=detect-ai-chats-api-service:50051
CHAT_GRPC_PORT=50051
CHAT_METRICS_PORT=9091
CHAT_WORKER_METRICS_PORT=9099
CHAT_MONGO_URI=mongodb://detect-ai-mongodb-router-service:27017
MONGO_URI=mongodb://detect-ai-mongodb-router-service:27017
CHAT_MONGO_DB=chats
MONGO_DATABASE=chats
CHAT_REDIS_MODE=cluster
CHAT_REDIS_ADDRS=detect-ai-redis-chat-leader:6379
CHAT_REDIS_POOL_SIZE=50
CHAT_WORKER_CONCURRENCY=20
CHAT_STREAM_PARTITION_COUNT=16
CHAT_CACHE_TTL=7200
CHAT_BATCH_SIZE=50

# ---- Inference Service -------------------------------------
INFERENCE_BATCH_SIZE=32
INFERENCE_BATCH_TIMEOUT=50
INFERENCE_MAX_TEXT_CHARS=10000
INFERENCE_BATCH_QUEUE_MAX_SIZE=500
INFERENCE_MAX_INFLIGHT_DOC_CHUNKS=200
INFERENCE_CHUNK_TOKEN_LIMIT=512
INFERENCE_CHUNK_TOKEN_STRIDE=50
INFERENCE_MODEL_CACHE_DIR=/app/models
INFERENCE_PROVIDERS=standard,premium

# ---- Workers -----------------------------------------------
WORKER_ANALYTICS_PORT=7001
WORKER_CRON_PORT=7002
WORKER_PAYMENTS_PORT=7003

# =============================================================
# Kubernetes Image Configuration
# These are used ONLY by the deploy script to override Helm
# image values. They are filtered out before creating Secrets.
# Format: kunalpisolkar/detect-ai-<service>:sha-<commit>
# =============================================================
K8S_IMAGE_REPO_WEB=kunalpisolkar/detect-ai-web
K8S_IMAGE_TAG_WEB=sha-ca5aa66

K8S_IMAGE_REPO_DOC_PARSER=kunalpisolkar/detect-ai-doc-parser
K8S_IMAGE_TAG_DOC_PARSER=sha-ca5aa66

K8S_IMAGE_REPO_INFERENCE=kunalpisolkar/detect-ai-inference
K8S_IMAGE_TAG_INFERENCE=sha-ca5aa66

K8S_IMAGE_REPO_CHATS=kunalpisolkar/detect-ai-chats
K8S_IMAGE_TAG_CHATS=sha-ca5aa66

K8S_IMAGE_REPO_PAYMENTS=kunalpisolkar/detect-ai-payments-gateway
K8S_IMAGE_TAG_PAYMENTS=sha-ca5aa66

K8S_IMAGE_REPO_WORKERS=kunalpisolkar/detect-ai-workers
K8S_IMAGE_TAG_WORKERS=sha-ca5aa66

# Copy to .env.<target> and fill in. Gitignored.
#   make -C e2e target-init TARGET=prod
#
# One file per environment. Each service reads only the keys it needs, so this
# file grows as more services are wired up.

# --- document parser ---
# From inside the k6 container, a service published on the Docker host is
# host.docker.internal:<host port>. Remote targets use their real hostname.
API_URL=http://host.docker.internal:8000

# --- payment gateway ---
GATEWAY_BASE_URL=http://host.docker.internal:8080
RABBITMQ_MGMT_URL=http://host.docker.internal:15672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_QUEUE=payment_events

# How the delivery proof is taken:
#   exact    - the broker's queue depth must match the gateway's publish count.
#              Needs an idle queue that nothing consumes (the local target).
#   at_least - the queue depth must be at least the publish count.
#   off      - the broker is not read; the gateway's own publish counters are
#              used. For a broker with a live consumer.
GATEWAY_LOAD_QUEUE_PROOF=exact

# The records the events are addressed to. They land in the target's own
# database once the worker consumes them, so point them at a dedicated record
# when the target is shared with real traffic.
GATEWAY_LOAD_SUB_ID=sub_123
GATEWAY_LOAD_USER_ID=user-123
GATEWAY_LOAD_PADDLE_SUB_ID=sub_456

# --- web ---
WEB_BASE_URL=http://host.docker.internal:3000

# The key the frontend and the gateway check the internal key against.
INTERNAL_API_KEY=test_internal_key_16chars

# The accounts the load scripts sign in with. They have to exist in the target
# already: the free one carries no subscription, the premium one an ACTIVE
# one. The load rig seeds them; a deployed target needs them planted once.
FREE_USER_EMAIL=load-free@detectai.test
PREMIUM_USER_EMAIL=load-premium@detectai.test
LOAD_USER_PASSWORD=LoadTest123!

# The budget for an analyze request. The rig answers from a mock backend, so
# its own defaults are milliseconds; a real inference stream takes seconds.
WEB_ANALYZE_P95_MS=
WEB_ANALYZE_P99_MS=

# Secrets the gateway checks the webhook signature against.
PADDLE_WEBHOOK_SECRET=test_webhook_secret_16chars

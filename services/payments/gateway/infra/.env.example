PADDLE_WEBHOOK_SECRET=
INTERNAL_API_KEY=
# Local standalone atom (infra/docker/rabbitmq/standalone.yml).
# Prod ignores RABBITMQ_USER/PASS/PORT below and uses Terraform secret
# detectai/mq/urls: RABBITMQ_URL=amqps://...:5671 + RABBITMQ_QUEUE_TYPE=quorum.
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
RABBITMQ_QUEUE_TYPE=classic
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672
PORT=8080
PORT_GATEWAY=8080
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=payment-gateway
GIN_MODE=release

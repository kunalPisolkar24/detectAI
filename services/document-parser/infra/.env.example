# Document Parser — copy to infra/.env (`make env`) and edit there; shell env wins.

# -- network ------------------------------------------------------------------
# Host port for compose; the container listens on 8000.
PORT=8000

# -- terraform seeding (consumed by tools/secrets.py) --------------------------
# A floci/LocalStack URL seeds there; empty seeds real AWS instead.
EMULATOR_ENDPOINT=http://localhost:4566
AWS_REGION=ap-southeast-2

# Terraform state bucket on both planes: renaming re-points terraform at a
# fresh ledger. On real AWS use your own unique bucket; terraform >= 1.10 there.
TF_STATE_BUCKET=detectai-docparser-tfstate

# -- auth ----------------------------------------------------------------------
# Shared secret, >= 16 chars. Dummy — never a real secret in this file.
API_KEY=change-me-min-16-chars

# -- deployment mode ------------------------------------------------------------
ENV_TYPE=dev                            # dev | prod; unset boots as dev

# -- limits ---------------------------------------------------------------------
UPLOAD_LIMIT_BYTES=3145728              # 3 MiB body cap
MAX_PDF_PAGES=1000
DOCX_MAX_UNCOMPRESSED_BYTES=31457280    # 30 MiB zip-bomb guard

# -- extraction (specification/references/extraction.md) ------------------------
# Fail-closed: unreadable or non-positive lands on the spec default.
PROCESSING_BUDGET_SECONDS=10            # overshoot -> 504
OUTPUT_CHAR_LIMIT=1000000               # hits set truncated: true

# -- phase-1 cleaning (specification/cleaning.md) -------------------------------
# Deletion thresholds; out-of-range fails the boot.
HEADER_REPETITION_RATIO=0.8            # rule (a): repetition share of pages, (0, 1)
REPETITION_MIN_PAGES=4                 # rule (a): floor page count, >= 2
HEADER_EDGE_ZONE_RATIO=0.20            # rule (a): zone per edge, (0, 0.5)
EDGE_ZONE_RATIO=0.10                   # rule (b): zone per edge, (0, 0.5)
EDGE_TOLERANCE_RATIO=0.02              # rule (a): y-band tolerance, (0, 1)
FOLIO_MONOTONIC_RATIO=0.70             # rule (b): per-run pair compliance, (0, 1)

# -- observability ---------------------------------------------------------------
# The endpoint gates emission: unset boots dark (NFR-5); set demands the key.
# US https://otlp.nr-data.net, EU https://otlp.eu01.nr-data.net
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=document-parser

# -- non-secret runtime config -> SSM --------------------------------------------
# `make secrets-apply` pushes every uncommented allowlisted key to
# /detectai/document-parser/<KEY>; the pipeline keys above never seed.
# OTEL_SERVICE_VERSION=0.1.0
# OTEL_TRACE_SAMPLE_RATIO=1.0            # 0 < ratio <= 1; 1.0 = everything

# -- observability secret ---------------------------------------------------------
# Ingest license key, only meaningful alongside an endpoint above.
# NEW_RELIC_LICENSE_KEY=dummy-dev-collector

# -- deploy identity (real-AWS iam-bootstrap) -------------------------------------
# Created by `make secrets-iam-bootstrap`; mandatory on real AWS,
# placeholder on the emulator.
# DEPLOY_TRUST_USER_ARN=arn:aws:iam::<account-id>:user/<your-user>

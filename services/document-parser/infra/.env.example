# Document Parser — canonical env (ENV_TYPE=dev|prod)
# Copy to infra/.env or export in shell (shell wins). See docs/08-configuration.md.

ENV_TYPE=dev

# -- network --------------------------------------------------------------
PORT=8000
WORKERS=4
WORKER_THREADS=4

# -- limits ---------------------------------------------------------------
MAX_UPLOAD_SIZE_BYTES=10485760
MAX_TEXT_LENGTH=1000000
MAX_PDF_PAGES=1000
MAX_DOCX_UNCOMPRESSED_BYTES=104857600
EXTRACTION_TIMEOUT_SECONDS=30.0
READINESS_MAX_QUEUE_DEPTH=50
HEADER_FOOTER_MARGIN_PT=40.0
HEADER_REPETITION_RATIO=0.8
ALLOWED_MIME_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/plain

# -- observability --------------------------------------------------------
LOG_LEVEL=INFO
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=document-parser
OTEL_SERVICE_VERSION=1.0.0
PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus-multiproc

# -- AWS / prod overrides -------------------------------------------------
# In prod (ENV_TYPE=prod) tunables come from SSM Parameter Store.
# Defaults: params /detectai/document-parser/*, optional secret detectai/document-parser/secrets
AWS_REGION=ap-south-1
# AWS_ENDPOINT_URL=http://host.docker.internal:4566  # Floci / LocalStack
# DOCUMENT_PARSER_SECRETS_NAME=detectai/document-parser/secrets
# SSM_PREFIX=/detectai/document-parser/
# SSM_ENABLED=true

# -- compose host bindings / network (optional) ---------------------------
# PORT is also the in-container port; override host side via PORT env
DETECT_AI_NETWORK=detect-ai-network

# -- Floci local prod test ------------------------------------------------
# ENV_TYPE=prod
# AWS_REGION=ap-south-1
# AWS_ENDPOINT_URL=http://host.docker.internal:4566
# Params via Floci SSM: /detectai/document-parser/* + optional secret detectai/document-parser/secrets

# Document Parser — copy to infra/.env (`make env`) and edit there; shell env wins.

# -- network --------------------------------------------------------------
# Host port for compose; the container always listens on 8000.
PORT=8000

# -- terraform seeding (consumed by tools/secrets.py) ------------------------
# EMULATOR_ENDPOINT: a floci/LocalStack URL seeds the blob there (local state,
# auto-apply); remove the line or leave it empty to seed real AWS instead.
EMULATOR_ENDPOINT=http://localhost:4566
AWS_REGION=ap-southeast-2
# The secrets blob lives at the fixed contract name detectai/document-parser/secrets
# (terraform pins it; nothing to configure here).

# TF_STATE_BUCKET: terraform state bucket, applied on BOTH planes — renaming it
# re-points terraform at a fresh ledger (nothing migrates). The value below is a
# mock: fine as-is on the emulator (unset also falls back to it, and any
# make secrets verb auto-creates the bucket when the emulator dropped it), but
# on real AWS replace it with your own unique sandbox bucket (required).
# terraform >= 1.10 on real AWS for use_lockfile.
TF_STATE_BUCKET=detectai-docparser-tfstate

# -- auth (consumed by the extract endpoint task) ---------------------------
# Shared secret, >= 16 chars. Dummy here — never a real secret in this file.
API_KEY=change-me-min-16-chars

# -- deployment mode ---------------------------------------------------------
ENV_TYPE=dev                            # dev | prod; unset boots as dev

# -- limits (consumed by the extract endpoint task) -------------------------
UPLOAD_LIMIT_BYTES=3145728             # 3 MiB body cap
MAX_PDF_PAGES=1000
DOCX_MAX_UNCOMPRESSED_BYTES=31457280   # 30 MiB zip-bomb guard

# -- extraction (specification/references/extraction.md) --------------------
# The pipeline's two consumption knobs, consumed since the route landed:
# fail-closed like the limits above — an unreadable or non-positive value
# lands on the spec default instead of failing the boot (the six cleaning
# knobs below are the fail-boot kind).
PROCESSING_BUDGET_SECONDS=10            # per-request processing budget; overshoot -> 504
OUTPUT_CHAR_LIMIT=1000000               # output cap; hits set truncated: true

# -- phase-1 cleaning (specification/cleaning.md) ---------------------------
# The pdf strategy's deletion thresholds; an out-of-range value fails the boot.
HEADER_REPETITION_RATIO=0.8            # rule (a): repetition share of pages, (0, 1)
REPETITION_MIN_PAGES=4                 # rule (a): floor page count, >= 2
HEADER_EDGE_ZONE_RATIO=0.20            # rule (a): zone per edge, (0, 0.5)
EDGE_ZONE_RATIO=0.10                   # rule (b): zone per edge, (0, 0.5)
EDGE_TOLERANCE_RATIO=0.02              # rule (a): y-band tolerance, (0, 1)
FOLIO_MONOTONIC_RATIO=0.70             # rule (b): per-run pair compliance, (0, 1)

# -- observability (consumed by the OTel build) ------------------------------
# The endpoint is the gate: set -> the OTel SDK pushes traces, metrics and
# logs; commented out or empty -> nothing is emitted (NFR-5). Prod points at
# New Relic's native OTLP endpoint, region-prefixed and matching the account
# (US https://otlp.nr-data.net, EU https://otlp.eu01.nr-data.net). A set
# endpoint always demands the license key below; a throwaway value is
# legitimate while the endpoint rides a local receiver.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=document-parser

# -- non-secret runtime config -> SSM (seeded by make secrets-apply) ---------
# An allowlist of the keys above rides to SSM when you apply: every uncommented,
# non-empty allowlisted key becomes /detectai/document-parser/<KEY>
# (tools/secrets.py maps them; terraform writes them). The secrets blob keeps
# API_KEY; pipeline keys (EMULATOR_ENDPOINT, AWS_REGION, TF_STATE_BUCKET, PORT)
# never seed. The app config reader (Settings) consumes every allowlisted key.
# OTEL_SERVICE_VERSION=0.1.0
# OTEL_TRACE_SAMPLE_RATIO=1.0            # 0 < ratio <= 1; 1.0 = everything

# -- observability secret -> the secrets blob (never SSM) --------------------
# The ingest license key for the endpoint above (Setup -> Integrations in New
# Relic). Dummy here — never a real secret in this file.
NEW_RELIC_LICENSE_KEY=dummy-dev-collector

# -- deploy identity (real-AWS iam-bootstrap only) ---------------------------
# make secrets-iam-bootstrap creates the out-of-stack deploy role that
# terraform runs under on real AWS; it trusts YOUR user + MFA, so this ARN is
# mandatory there. On the emulator a placeholder fills it (IAM is structural
# only on Floci).
# DEPLOY_TRUST_USER_ARN=arn:aws:iam::<account-id>:user/<your-user>

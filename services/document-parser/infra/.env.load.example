# Document Parser load + e2e — copy to infra/.env.load (`make load-env`) and edit.
# The single lever for both commands: compose injects it wholesale into the
# rig's parser and the k6 container, and no CLI or shell overrides exist.
#   make load-test   container rig (parser + k6 on an isolated network)
#   make load-e2e    k6 only, against whatever API_URL names below
# Two scenarios: smoke posts one healthy pass (format spread + the full
# rejection matrix, every request exact-asserted); load is the performance
# run, shaped by the STAGES key below.

# smoke | load.
SCENARIO=smoke

# Bare for load-test: the rig's k6 then uses the script default
# http://document-parser:8000 (its in-network parser). For load-e2e set the
# deployment to hit: make run, a docker stack, a Lambda function URL, prod —
# anything answering POST /api/v1/extract.
API_URL=
# The shared key, read by both containers: the parser's guard (API_KEY) and
# the x-api-key the scenarios send, so smoke's 401 cases are real.
# Must be >= 16 chars — the service's key floor.
API_KEY=change-me-min-16-chars

# The load shape dial: duration:arrivals-per-second steps. 5s:1,10s:2,5s:0
# ramps from 1 to 2 arrivals/s for ~20s — light enough for any laptop. A
# spike is a taller middle (10s:10,30s:20,10s:0); a soak is one long flat
# step (4h:2). Heavy shapes on heavy mixes (~10 arrivals/s at 5/s start and
# mid-tier corpus rows) will breach the latency trio — loosen the budgets
# below for the heavy run, then put them back.
STAGES=5s:1,10s:2,5s:0
# Ceiling of VUs k6 may spin to absorb arrival bursts.
MAX_VUS=20

# Round-robin mix for extract traffic — corpus rows under tests/load/assets
# (generated once by make load-fixtures; see tests/load/README.md).
DOCPARSER_LOAD_PROFILES=short.txt,mid.txt,long.txt,short.pdf,short.docx
# The smoke matrix's oversized raw body; must EXCEED the target's upload
# limit (the rig parser caps at 3 MiB).
DOCPARSER_LOAD_OVERSIZE_BYTES=4194304
# HTTP budget carried by every request the scripts send.
DOCPARSER_LOAD_REQUEST_TIMEOUT=35s

# Latency and success budgets for the load scenario; a breach exits
# non-zero. Smoke asserts every check instead (all pass, or nothing).
DOCPARSER_LOAD_P95_MS=1500
DOCPARSER_LOAD_P99_MS=3000
DOCPARSER_LOAD_MIN_SUCCESS_RATE=0.99

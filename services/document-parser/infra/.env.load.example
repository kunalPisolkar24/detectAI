# Document Parser load + e2e — copied to infra/.env.load by `make load-env`.
# make load-test: container rig. make load-e2e: k6 alone against API_URL.

# smoke | load.
SCENARIO=smoke

# Bare = in-network parser (load-test); set a deployment for load-e2e.
API_URL=
# Shared key for the parser guard and the scenarios; >= 16 chars.
API_KEY=change-me-min-16-chars

# Load shape: duration:arrivals-per-second steps.
STAGES=5s:1,10s:2,5s:0
# VU ceiling for arrival bursts.
MAX_VUS=20

# Corpus rows under tests/load/assets; `make load-fixtures` generates them once.
DOCPARSER_LOAD_PROFILES=short.txt,mid.txt,long.txt,short.pdf,short.docx
# Oversized smoke body; must exceed the target's upload limit.
DOCPARSER_LOAD_OVERSIZE_BYTES=4194304
# HTTP budget carried by every request.
DOCPARSER_LOAD_REQUEST_TIMEOUT=35s

# Load budgets; a breach exits non-zero. Smoke exact-asserts every check instead.
DOCPARSER_LOAD_P95_MS=1500
DOCPARSER_LOAD_P99_MS=3000
DOCPARSER_LOAD_MIN_SUCCESS_RATE=0.99

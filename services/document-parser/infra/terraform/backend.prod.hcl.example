# Real AWS prod backend — copy to backend.prod.hcl and fill the bucket.
# Usage (tools/secrets.py runs this automatically when EMULATOR_ENDPOINT is unset):
#   cp backend.prod.hcl.example backend.prod.hcl
#   # Edit bucket name (must exist, versioned, encrypted)
#   terraform -chdir=... init -reconfigure -backend-config=backend.prod.hcl
#
# The tfstate holds the api_key in plaintext; the bucket must be versioned and
# encrypted, and access restricted to the operators who run the seed.

bucket       = "REPLACE-me-detectai-doc-parser-tfstate"
key          = "document-parser/terraform.tfstate"
region       = "ap-south-1"
encrypt      = true
use_lockfile = true

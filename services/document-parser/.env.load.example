# Document Parser load + e2e — copy to .env.load (`make load-env`) and edit.
# One file drives both commands:
#   make load-test   container rig (parser + k6 on an isolated network)
#   make load-e2e    k6 only, against whatever API_URL names below
# Shell env wins over this file (compose --env-file precedence), so a one-off
# `STAGES=10s:20 make load-test` overrides without editing.

# -- scenario ------------------------------------------------------------------
# Which k6 script runs: smoke | negative | load | stress | soak | legacy.
SCENARIO=smoke

# -- shape ---------------------------------------------------------------------
# Generic knobs; a scenario-specific DOCPARSER_LOAD_* key overrides them, and
# an unset one falls back to the script's built-in default (load/lib/config.js).
# NOTE: compose's env-file parser supports no inline comments — write comments
# on their own line, and leave a knob bare to use the script default.
STAGES=5s:5,10s:5,5s:0
ITERATIONS=2
DURATION=
VUS=
RPS=
MAX_VUS=

# -- target --------------------------------------------------------------------
# Container mode ignores these (k6 talks to the rig's parser over its network).
# E2e mode sends traffic to THIS url: make run, a docker stack, a Lambda
# function URL, prod — anything answering POST /api/v1/extract.
API_URL=http://host.docker.internal:8000
# The shared key as x-api-key. The rig boots its parser with the same value
# (container env API_KEY), so the 401 negative cases are real there.
# Must be >= 16 chars — the service's key floor.
PARSE_API_KEY=change-me-min-16-chars

# -- fixtures ------------------------------------------------------------------
# Round-robin mix for load/stress/soak (profile names in load/lib/files.js).
DOCPARSER_LOAD_PROFILES=txt-small,txt-medium,txt-large,pdf-small,docx-small
# The negative scenario's oversized body; must EXCEED the target's upload
# limit (the rig parser caps at 3 MiB).
DOCPARSER_LOAD_OVERSIZE_BYTES=4194304

# -- request timeout -------------------------------------------------------------
DOCPARSER_LOAD_REQUEST_TIMEOUT=35s

# -- budgets (per scenario; a breach exits non-zero) ------------------------------
DOCPARSER_LOAD_P95_MS=1500
DOCPARSER_LOAD_P99_MS=3000
DOCPARSER_LOAD_TXT_P95_MS=500
DOCPARSER_LOAD_MIN_SUCCESS_RATE=0.99
DOCPARSER_LOAD_STRESS_P95_MS=3000
DOCPARSER_LOAD_STRESS_P99_MS=6000
DOCPARSER_LOAD_STRESS_MIN_SUCCESS_RATE=0.95
DOCPARSER_LOAD_SOAK_P95_MS=3000
DOCPARSER_LOAD_SOAK_P99_MS=5000
DOCPARSER_LOAD_SOAK_MIN_SUCCESS_RATE=0.99
DOCPARSER_LOAD_NEGATIVE_MIN_SUCCESS_RATE=1

# -- fine-tuning (per-scenario overrides of the generic shape) --------------------
# DOCPARSER_LOAD_SMOKE_VUS=1
# DOCPARSER_LOAD_SMOKE_ITERATIONS=1
# DOCPARSER_LOAD_NEGATIVE_VUS=1
# DOCPARSER_LOAD_NEGATIVE_ITERATIONS=6
# DOCPARSER_LOAD_SOAK_VUS=2
# DOCPARSER_LOAD_SOAK_DURATION=5m
# DOCPARSER_LOAD_SOAK_GRACEFUL_STOP=30s
# DOCPARSER_LOAD_STRESS_START_RATE=1
# DOCPARSER_LOAD_STRESS_PREALLOCATED_VUS=20
# DOCPARSER_LOAD_STRESS_MAX_VUS=100
# DOCPARSER_LOAD_STRESS_STAGES=10s:5,30s:10,10s:0
# DOCPARSER_LOAD_STRESS_GRACEFUL_STOP=30s
# DOCPARSER_LOAD_STAGES=5s:5,10s:5,5s:0
# DOCPARSER_LOAD_GRACEFUL_STOP=30s
# MODE=vus                          # legacy script only: vus | rps

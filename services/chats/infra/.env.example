ENV_TYPE=dev
PORT=8090
DRAIN_TIMEOUT=10s
MONGO_URI=mongodb://host.docker.internal:27017
MONGO_DATABASE=chat_db
REDIS_ENDPOINT=redis://host.docker.internal:6379
API_KEY=local-dev-api-key-16-chars
RATE_LIMIT_CREATE_MAX=10
RATE_LIMIT_WRITE_MAX=60
OTEL_SERVICE_NAME=chats
# OTEL_SERVICE_VERSION=0.1.0
# OTEL_TRACE_SAMPLE_RATIO=1.0
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp.eu01.nr-data.net
NEW_RELIC_LICENSE_KEY=dummy-dev-license-key
AWS_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=x
AWS_SECRET_ACCESS_KEY=x
AWS_SESSION_TOKEN=x
# SECRET_RECOVERY_WINDOW=30
AWS_ENDPOINT_URL_SECRETS_MANAGER=http://host.docker.internal:4566
AWS_ENDPOINT_URL_SSM=http://host.docker.internal:4566

# Chats — canonical env (ENV_TYPE=dev|prod)
# Copy to infra/.env or export in shell (shell wins). See docs/getting-started/configuration.md.
# dev: compose defaults from this file / env; prod: AWS Secrets Manager (detectai/docdb/urls + detectai/redis/chat/urls) + SSM /detectai/chat/.

ENV_TYPE=dev
SERVICE_ROLE=api
GRPC_PORT=:50051
METRICS_PORT=:9091
WORKER_METRICS_PORT=:9099

# -- persistence --------------------------------------------------------
MONGO_URI=mongodb://mongo-chat:27017
MONGO_DATABASE=chat_db
MONGO_MODE=standalone
MONGO_TLS_ENABLED=false
MONGO_TLS_CA_FILE=
MONGO_MAX_POOL_SIZE=100
MONGO_MIN_POOL_SIZE=10
MONGO_SERVER_SELECTION_TIMEOUT=5s

# -- redis (streams + cache) — compose uses standalone redis:7, prod uses ElastiCache (detectai/redis/chat)
CHAT_REDIS_ADDR=redis-chat:6379
REDIS_URL=
REDIS_PASSWORD=test_redis_password
REDIS_TLS_ENABLED=false
REDIS_TLS_CA_FILE=
REDIS_POOL_SIZE=100

# -- performance --------------------------------------------------------
BATCH_SIZE=50
STREAM_PARTITION_COUNT=16
CACHE_TTL=24h

# -- observability ------------------------------------------------------
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=chat-service
AWS_REGION=ap-south-1

# -- prod AWS bootstrap (only when ENV_TYPE=prod) ----------------------
# AWS_ENDPOINT_URL=http://host.docker.internal:4566  # Floci / LocalStack
# SSM_PREFIX=/detectai/chat/
# SSM_ENABLED=true
# DOCDB_URLS_SECRET_NAME=detectai/docdb/urls
# REDIS_URLS_SECRET_NAME=detectai/redis/chat/urls

# -- compose host bindings (optional) -----------------------------------
MONGO_CHAT_PORT=27018
REDIS_CHAT_PORT=6381
CHAT_GRPC_HOST_PORT=50052
CHAT_METRICS_HOST_PORT=9095
CHAT_WORKER_METRICS_PORT_HOST=9099

# -- Floci local prod test ----------------------------------------------
# ENV_TYPE=prod
# AWS_REGION=ap-south-1
# AWS_ENDPOINT_URL=http://host.docker.internal:4566
# Secrets via Floci: detectai/docdb/urls {MONGO_URI,MONGO_DATABASE,MONGO_MODE} + detectai/redis/chat/urls {CHAT_REDIS_ADDR,REDIS_PASSWORD,REDIS_TLS_ENABLED} + SSM /detectai/chat/*

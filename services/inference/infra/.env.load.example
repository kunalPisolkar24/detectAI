GRPC_PORT=50051
API_KEY=change-me-min-16-chars
ENV_TYPE=dev
MODEL_CACHE_DIR=/models
ENABLED_MODELS=spark,flare
FLARE_MODEL_REPO=kpisolkar24/detect-ai-flare
FLARE_MODEL_REVISION=27f289bbd45063a28be75450863c784574fad76f
FLARE_MODEL_DIR=onnx/fp32
SPARK_MODEL_REPO=kpisolkar24/detect-ai-spark
SPARK_MODEL_REVISION=b0ab87257cc240d66622c2482270ec726e16c553
SPARK_MODEL_DIR=onnx/fp16
LOG_LEVEL=INFO
MAX_TEXT_CHARS=1000000
CHUNK_TOKEN_LIMIT=512
CHUNK_TOKEN_OVERLAP=0
INFERENCE_BATCH_SIZE=8
MAX_CONCURRENT_BATCHES=2
MAX_INFLIGHT_REQUESTS=8
FLARE_BATCH_SIZE=16
SPARK_BATCH_SIZE=32
FLARE_MAX_SEQUENCE_LENGTH=512
SPARK_MAX_SEQUENCE_LENGTH=512
AI_DETECTION_THRESHOLD=0.5
INFERENCE_PROVIDERS=CPUExecutionProvider
ORT_INTRA_OP_THREADS=0
SCENARIO=smoke
GRPC_ADDR=inference:50051
INFERENCE_LOAD_PROTO_DIR=/proto
INFERENCE_LOAD_PROFILES=short,medium,long
INFERENCE_LOAD_STAGES=5s:1,10s:1,5s:0
INFERENCE_LOAD_MAX_VUS=4
INFERENCE_LOAD_CONNECT_TIMEOUT=10s
INFERENCE_LOAD_RPC_TIMEOUT=120s
INFERENCE_LOAD_P95_MS=60000
INFERENCE_LOAD_P99_MS=90000
INFERENCE_LOAD_TTFC_P95_MS=10000
INFERENCE_LOAD_MIN_SUCCESS_RATE=0.95

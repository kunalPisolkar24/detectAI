# Inference Service — canonical env (ENV_TYPE=dev|prod)
# Copy to infra/.env or export in shell (shell wins). See docs/08-configuration.md.

ENV_TYPE=dev

# -- required -------------------------------------------------------------
API_KEY=dev-secret-key-16chars-at-least

# -- optional tunables (defaults shown) -----------------------------------
LOG_LEVEL=INFO
GRPC_PORT=50051
GRPC_MAX_WORKERS=50
METRICS_PORT=8333
MODEL_CACHE_DIR=./models
SPARK_MODEL_REVISION=9a48004391c71272d6fb1d164ed7c56e1fbfe360
FLARE_MODEL_REVISION=e1911c0be59f4e10f0d120f639d1358e46bc2086
BATCH_SIZE=32
BATCH_TIMEOUT=0.05
BATCH_QUEUE_MAX_SIZE=1024
MAX_TEXT_CHARS=50000
MAX_GLOBAL_TOKENS=10000
CHUNK_TOKEN_LIMIT=256
CHUNK_TOKEN_STRIDE=192
MAX_CONCURRENT_BATCHES=4
INFERENCE_MAX_WORKERS=32
MAX_INFLIGHT_DOC_CHUNKS=8
INFERENCE_PROVIDERS=CPUExecutionProvider

# -- observability --------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=inference
OTEL_SERVICE_VERSION=0.1.0

# -- AWS / prod overrides -------------------------------------------------
# In prod (ENV_TYPE=prod) secrets come from Secrets Manager and tunables from SSM.
# Defaults: secret detectai/inference/secrets {API_KEY, HF_TOKEN}, params /detectai/inference/*
AWS_REGION=ap-south-1
# AWS_ENDPOINT_URL=http://host.docker.internal:4566  # Floci / LocalStack
# INFERENCE_SECRETS_NAME=detectai/inference/secrets
# SSM_PREFIX=/detectai/inference/
# SSM_ENABLED=true
# HF_TOKEN is optional, pulled from secret when private HF repos are used

# -- compose host bindings / network (optional) ---------------------------
# GRPC_PORT and METRICS_PORT are also the in-container ports; override host side via:
#   GRPC_PORT=50051 METRICS_PORT=8333  (compose maps ${GRPC_PORT}:${GRPC_PORT})
DETECT_AI_NETWORK=detect-ai-network

# -- Floci local prod test ------------------------------------------------
# ENV_TYPE=prod
# AWS_REGION=ap-south-1
# AWS_ENDPOINT_URL=http://host.docker.internal:4566
# Secrets via Floci: detectai/inference/secrets {API_KEY, HF_TOKEN} + SSM /detectai/inference/*

# Inference Service – Standalone infra env (see root infra/docker/local/.env.example for full stack)
ENV=production
LOG_LEVEL=INFO
GRPC_PORT=50051
GRPC_MAX_WORKERS=50
METRICS_PORT=8333
API_KEY=dev-secret-key-16chars-at-least
MODEL_CACHE_DIR=./models
SPARK_MODEL_REVISION=9a48004391c71272d6fb1d164ed7c56e1fbfe360
FLARE_MODEL_REVISION=e1911c0be59f4e10f0d120f639d1358e46bc2086
BATCH_SIZE=32
BATCH_TIMEOUT=0.05
BATCH_QUEUE_MAX_SIZE=1024
MAX_TEXT_LENGTH=50000
MAX_TEXT_CHARS=50000
MAX_GLOBAL_TOKENS=10000
CHUNK_TOKEN_LIMIT=256
CHUNK_TOKEN_STRIDE=192
MAX_CONCURRENT_BATCHES=4
INFERENCE_MAX_WORKERS=32
MAX_INFLIGHT_DOC_CHUNKS=8
INFERENCE_PROVIDERS=CPUExecutionProvider
INFERENCE_MODEL_CACHE_DIR=./models
PORT_INFERENCE=50051
PORT_INFERENCE_METRICS=8333
AI_SERVICE_API_KEY=dev-secret-key-16chars-at-least
INFERENCE_BATCH_SIZE=32
INFERENCE_BATCH_TIMEOUT=0.05
INFERENCE_MAX_TEXT_CHARS=50000
INFERENCE_BATCH_QUEUE_MAX_SIZE=1024
INFERENCE_MAX_INFLIGHT_DOC_CHUNKS=8
INFERENCE_CHUNK_TOKEN_LIMIT=256
INFERENCE_CHUNK_TOKEN_STRIDE=192
detect_ai_network=detect-ai-network
COMPOSE_PROJECT_NAME=detect_ai

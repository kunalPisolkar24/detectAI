GRPC_PORT=50051

AWS_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=x
AWS_SECRET_ACCESS_KEY=x
# SECRET_RECOVERY_WINDOW=30

API_KEY=change-me-min-16-chars
HF_TOKEN=hf_change_me

ENV_TYPE=dev

MODEL_CACHE_DIR=./models

ENABLED_MODELS=spark

FLARE_MODEL_REPO=your-org/detect-ai-flare
FLARE_MODEL_REVISION=deadbeefdeadbeefdeadbeefdeadbeefdeadbeef
FLARE_MODEL_DIR=onnx/fp32

SPARK_MODEL_REPO=your-org/detect-ai-spark
SPARK_MODEL_REVISION=c0ffee00c0ffee00c0ffee00c0ffee00c0ffee00
SPARK_MODEL_DIR=onnx/fp16

LOG_LEVEL=INFO

MAX_TEXT_CHARS=1000000

CHUNK_TOKEN_LIMIT=512

CHUNK_TOKEN_OVERLAP=0

INFERENCE_BATCH_SIZE=8

MAX_CONCURRENT_BATCHES=2

MAX_INFLIGHT_REQUESTS=8

FLARE_BATCH_SIZE=16

SPARK_BATCH_SIZE=32

FLARE_MAX_SEQUENCE_LENGTH=512

SPARK_MAX_SEQUENCE_LENGTH=512

AI_DETECTION_THRESHOLD=0.5

INFERENCE_PROVIDERS=CPUExecutionProvider

ORT_INTRA_OP_THREADS=0

OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=inference
NEW_RELIC_LICENSE_KEY=dummy-dev-collector


# Workers stacks (services/workers/infra/compose.<worker>.yml).
# Copy to services/workers/infra/.env and adjust secrets, or export the
# variables in the shell (shell wins over this file):
#   cp .env.example .env   # from services/workers/infra
# Each stack is self-contained: `make worker-up WORKER=payments` boots the
# worker plus only the datastores it needs (see matrix below), isolated by
# project name. Host ports are overridable so stacks run side by side.
#
#   worker     postgres-users  redis-users  redis-events  rabbitmq
#   analytics  yes             yes          no            yes
#   cron       yes             yes          no            no
#   payments   yes             yes          yes           yes
#
# Each stack is an isolated compose project (see `name:` in
# compose.<worker>.yml), so `down -v` on one never touches another.
# Running two stacks side by side on one machine needs distinct HOST ports,
# e.g.: POSTGRES_PORT=5434 REDIS_PORT=6399 EVENT_REDIS_PORT=6390
#       RABBITMQ_PORT=5674 WORKER_PAYMENTS_PORT=7103 make worker-up WORKER=payments
# (Container ports and service URLs stay unchanged — only host bindings move.)
#
# Sharing one dataset across terminals (reliable testing): boot the owner
# stack fully in terminal 1, then boot the second worker with the matching
# WITH_*=0 flags plus URLs pointing at the owner's published host ports:
#   terminal 1:  make worker-up WORKER=cron
#   terminal 2:  make worker-up WORKER=payments WITH_POSTGRES=0 WITH_REDIS=0 \
#                  DATABASE_URL=postgresql://user:password@host.docker.internal:5432/detect_ai \
#                  REDIS_URL=redis://:user_cache_password@host.docker.internal:6379
# WITH_X=0 with a URL still pointing at this stack fails fast (see Makefile
# guard). Terminal 1 owns migrations; WITH_POSTGRES=0 skips db-migrate.

NODE_ENV=production

# Postgres (all workers)
# Local: REPLICA equals primary (standalone). Aurora: REPLICA is the reader endpoint (Terraform output, sslmode=require).
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=detect_ai
POSTGRES_PORT=5432
DATABASE_URL=postgresql://user:password@postgres-users:5432/detect_ai
DATABASE_URL_REPLICA=postgresql://user:password@postgres-users:5432/detect_ai

# Redis user cache (all workers): basic/sub + rate-limit + analytics dedup
REDIS_MODE=standalone
REDIS_URL=redis://:user_cache_password@redis-users:6379
REDIS_PASSWORD=user_cache_password
REDIS_PORT=6379
REDIS_MASTER_NAME=mymaster
REDIS_SENTINELS=redis-sentinel-1:26379

# Redis events, Paddle-only (payments only): paddle:evt:* + payment:event:ts:*
EVENT_REDIS_MODE=standalone
EVENT_REDIS_URL=redis://:events_password@redis-events:6379
EVENT_REDIS_PASSWORD=events_password
EVENT_REDIS_PORT=6381
EVENT_REDIS_SENTINELS=
EVENT_REDIS_MASTER_NAME=

# RabbitMQ (analytics + payments)
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
RABBITMQ_QUEUE_TYPE=quorum
RABBITMQ_PORT=5672

# Paddle (payments only)
PADDLE_API_KEY=mock-paddle-api-key-not-configured
PADDLE_ENVIRONMENT=sandbox

# Cron tuning (cron only)
CRON_CHECK_INTERVAL_MS=900000
CRON_BATCH_SIZE=100

# Health ports (override per stack to run side by side)
WORKER_ANALYTICS_PORT=7001
WORKER_CRON_PORT=7002
WORKER_PAYMENTS_PORT=7003

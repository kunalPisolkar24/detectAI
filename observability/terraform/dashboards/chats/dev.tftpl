{
  "name": "detectai-chats (dev)",
  "description": "Chats (deployment.environment = dev): ConnectRPC chat service — golden signals, per-procedure latency, and the cache/datastore/rate-limit/validation signals the service emits itself. No exporters, worker or collector path.",
  "permissions": "PUBLIC_READ_WRITE",
  "pages": [
    {
      "name": "Chat Service",
      "description": "chats golden signals, per-procedure latency and errors, plus the app-emitted dependency signals",
      "widgets": [
        {
          "title": "RPC/min (dev)",
          "layout": {
            "column": 1,
            "row": 1,
            "height": 3,
            "width": 3
          },
          "visualization": {
            "id": "viz.gauge"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": ${account_id},
                "query": "FROM Metric SELECT rate(sum(chats_rpc_requests_total), 1 minute) AS `rpm` WHERE deployment.environment = 'dev' AND service.name = 'chats'"
              }
            ],
            "limit": 500
          }
        },
        {
          "title": "Error share (dev)",
          "layout": {
            "column": 4,
            "row": 1,
            "height": 3,
            "width": 3
          },
          "visualization": {
            "id": "viz.gauge"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": ${account_id},
                "query": "FROM Span SELECT percentage(count(*), WHERE error = true) AS `error %` WHERE deployment.environment = 'dev' AND service.name = 'chats' AND rpc.system = 'connect_rpc'"
              }
            ],
            "limit": 2,
            "thresholds": {
              "alert": {
                "value": 2
              },
              "warning": {
                "value": 1
              }
            }
          }
        },
        {
          "title": "RPC p95 all ops (dev)",
          "layout": {
            "column": 7,
            "row": 1,
            "height": 3,
            "width": 3
          },
          "visualization": {
            "id": "viz.gauge"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": ${account_id},
                "query": "FROM Span SELECT percentile(duration.ms, 95) AS `p95 ms` WHERE deployment.environment = 'dev' AND service.name = 'chats' AND rpc.system = 'connect_rpc'"
              }
            ],
            "limit": 500
          }
        },
        {
          "title": "RPC p99 all ops (dev)",
          "layout": {
            "column": 10,
            "row": 1,
            "height": 3,
            "width": 3
          },
          "visualization": {
            "id": "viz.gauge"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": ${account_id},
                "query": "FROM Span SELECT percentile(duration.ms, 99) AS `p99 ms` WHERE deployment.environment = 'dev' AND service.name = 'chats' AND rpc.system = 'connect_rpc'"
              }
            ],
            "limit": 500
          }
        },
        {
          "title": "RPC throughput by procedure (dev)",
          "layout": {
            "column": 1,
            "row": 2,
            "height": 3,
            "width": 6
          },
          "visualization": {
            "id": "viz.area"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": ${account_id},
                "query": "FROM Metric SELECT rate(sum(chats_rpc_requests_total), 1 minute) AS `rpm` WHERE deployment.environment = 'dev' AND service.name = 'chats' FACET procedure TIMESERIES AUTO LIMIT 10"
              }
            ],
            "legend": {
              "enabled": true
            },
            "yAxisLeft": {
              "zero": true,
              "min": 0
            },
            "chartStyles": {
              "lineInterpolation": "smooth",
              "gradient": {
                "enabled": true
              }
            }
          }
        },
        {
          "title": "RPC p95 by procedure (dev)",
          "layout": {
            "column": 7,
            "row": 2,
            "height": 3,
            "width": 6
          },
          "visualization": {
            "id": "viz.area"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": ${account_id},
                "query": "FROM Span SELECT percentile(duration.ms, 95) WHERE deployment.environment = 'dev' AND service.name = 'chats' AND rpc.system = 'connect_rpc' FACET `rpc.method` TIMESERIES AUTO LIMIT 10"
              }
            ],
            "legend": {
              "enabled": true
            },
            "yAxisLeft": {
              "zero": true,
              "min": 0
            },
            "chartStyles": {
              "lineInterpolation": "smooth",
              "gradient": {
                "enabled": true
              }
            }
          }
        },
        {
          "title": "RPC p99 by procedure (dev)",
          "layout": {
            "column": 1,
            "row": 3,
            "height": 3,
            "width": 6
          },
          "visualization": {
            "id": "viz.area"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": ${account_id},
                "query": "FROM Span SELECT percentile(duration.ms, 99) WHERE deployment.environment = 'dev' AND service.name = 'chats' AND rpc.system = 'connect_rpc' FACET `rpc.method` TIMESERIES AUTO LIMIT 10"
              }
            ],
            "legend": {
              "enabled": true
            },
            "yAxisLeft": {
              "zero": true,
              "min": 0
            },
            "chartStyles": {
              "lineInterpolation": "smooth",
              "gradient": {
                "enabled": true
              }
            }
          }
        },
        {
          "title": "RPC errors by code (dev)",
          "layout": {
            "column": 7,
            "row": 3,
            "height": 3,
            "width": 6
          },
          "visualization": {
            "id": "viz.stacked-bar"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": ${account_id},
                "query": "FROM Metric SELECT sum(chats_rpc_errors_total) AS errors WHERE deployment.environment = 'dev' AND service.name = 'chats' FACET code TIMESERIES AUTO LIMIT 10"
              }
            ],
            "legend": {
              "enabled": true
            },
            "yAxisLeft": {
              "zero": true,
              "min": 0
            },
            "chartStyles": {
              "gradient": {
                "enabled": true
              },
              "seriesOrder": "original",
              "stacked": {
                "enabled": true
              }
            }
          }
        },
        {
          "title": "Cache operations by result (dev)",
          "layout": {
            "column": 1,
            "row": 4,
            "height": 3,
            "width": 6
          },
          "visualization": {
            "id": "viz.area"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": ${account_id},
                "query": "FROM Metric SELECT rate(sum(chats_cache_operations_total), 1 minute) AS `ops/min` WHERE deployment.environment = 'dev' AND service.name = 'chats' FACET result TIMESERIES AUTO LIMIT 6"
              }
            ],
            "legend": {
              "enabled": true
            },
            "yAxisLeft": {
              "zero": true,
              "min": 0
            },
            "chartStyles": {
              "lineInterpolation": "smooth",
              "gradient": {
                "enabled": true
              }
            }
          }
        },
        {
          "title": "Cache operation latency (dev)",
          "layout": {
            "column": 7,
            "row": 4,
            "height": 3,
            "width": 6
          },
          "visualization": {
            "id": "viz.area"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": ${account_id},
                "query": "FROM Metric SELECT average(chats_cache_operation_duration_seconds) * 1000 AS `avg ms` WHERE deployment.environment = 'dev' AND service.name = 'chats' FACET operation TIMESERIES AUTO LIMIT 10"
              }
            ],
            "legend": {
              "enabled": true
            },
            "yAxisLeft": {
              "zero": true,
              "min": 0
            },
            "chartStyles": {
              "lineInterpolation": "smooth",
              "gradient": {
                "enabled": true
              }
            }
          }
        },
        {
          "title": "Datastore operations by result (dev)",
          "layout": {
            "column": 1,
            "row": 5,
            "height": 3,
            "width": 6
          },
          "visualization": {
            "id": "viz.area"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": ${account_id},
                "query": "FROM Metric SELECT rate(sum(chats_datastore_operations_total), 1 minute) AS `ops/min` WHERE deployment.environment = 'dev' AND service.name = 'chats' FACET result TIMESERIES AUTO LIMIT 6"
              }
            ],
            "legend": {
              "enabled": true
            },
            "yAxisLeft": {
              "zero": true,
              "min": 0
            },
            "chartStyles": {
              "lineInterpolation": "smooth",
              "gradient": {
                "enabled": true
              }
            }
          }
        },
        {
          "title": "Datastore operation latency (dev)",
          "layout": {
            "column": 7,
            "row": 5,
            "height": 3,
            "width": 6
          },
          "visualization": {
            "id": "viz.area"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": ${account_id},
                "query": "FROM Metric SELECT average(chats_datastore_operation_duration_seconds) * 1000 AS `avg ms` WHERE deployment.environment = 'dev' AND service.name = 'chats' FACET operation TIMESERIES AUTO LIMIT 10"
              }
            ],
            "legend": {
              "enabled": true
            },
            "yAxisLeft": {
              "zero": true,
              "min": 0
            },
            "chartStyles": {
              "lineInterpolation": "smooth",
              "gradient": {
                "enabled": true
              }
            }
          }
        },
        {
          "title": "Rate-limit refusals by scope (dev)",
          "layout": {
            "column": 1,
            "row": 6,
            "height": 3,
            "width": 6
          },
          "visualization": {
            "id": "viz.area"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": ${account_id},
                "query": "FROM Metric SELECT rate(sum(chats_rate_limit_refusals_total), 1 minute) AS `refusals/min` WHERE deployment.environment = 'dev' AND service.name = 'chats' FACET scope TIMESERIES AUTO LIMIT 5"
              }
            ],
            "legend": {
              "enabled": true
            },
            "yAxisLeft": {
              "zero": true,
              "min": 0
            },
            "chartStyles": {
              "lineInterpolation": "smooth",
              "gradient": {
                "enabled": true
              }
            }
          }
        },
        {
          "title": "Validation rejections by field (dev)",
          "layout": {
            "column": 7,
            "row": 6,
            "height": 3,
            "width": 6
          },
          "visualization": {
            "id": "viz.area"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": ${account_id},
                "query": "FROM Metric SELECT rate(sum(chats_validation_rejections_total), 1 minute) AS `rejections/min` WHERE deployment.environment = 'dev' AND service.name = 'chats' FACET field TIMESERIES AUTO LIMIT 10"
              }
            ],
            "legend": {
              "enabled": true
            },
            "yAxisLeft": {
              "zero": true,
              "min": 0
            },
            "chartStyles": {
              "lineInterpolation": "smooth",
              "gradient": {
                "enabled": true
              }
            }
          }
        },
        {
          "title": "Slowest RPCs (dev)",
          "layout": {
            "column": 1,
            "row": 7,
            "height": 3,
            "width": 12
          },
          "visualization": {
            "id": "viz.table"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": ${account_id},
                "query": "FROM Span SELECT average(duration.ms) AS `avg ms`, max(duration.ms) AS `max ms`, count(*) AS calls WHERE deployment.environment = 'dev' AND service.name = 'chats' AND rpc.system = 'connect_rpc' FACET `rpc.method` LIMIT 20"
              }
            ]
          }
        },
        {
          "title": "Service versions reporting (dev)",
          "layout": {
            "column": 1,
            "row": 8,
            "height": 3,
            "width": 12
          },
          "visualization": {
            "id": "viz.table"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": ${account_id},
                "query": "FROM Span SELECT count(*) AS spans FACET service.name, service.version WHERE deployment.environment = 'dev' AND service.name = 'chats' LIMIT 20"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "Logs",
      "description": "chats error/warn stream, log volume and slow RPCs",
      "widgets": [
        {
          "title": "Error and warn stream (latest 100) (dev)",
          "layout": {
            "column": 1,
            "row": 1,
            "height": 4,
            "width": 12
          },
          "visualization": {
            "id": "viz.table"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": ${account_id},
                "query": "FROM Log SELECT timestamp, `severity.text`, message, `trace.id` WHERE deployment.environment = 'dev' AND service.name = 'chats' AND `severity.text` IN ('ERROR', 'WARN') LIMIT 100"
              }
            ]
          }
        },
        {
          "title": "Log volume by level (dev)",
          "layout": {
            "column": 1,
            "row": 2,
            "height": 3,
            "width": 6
          },
          "visualization": {
            "id": "viz.area"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": ${account_id},
                "query": "FROM Log SELECT count(*) WHERE deployment.environment = 'dev' AND service.name = 'chats' FACET `severity.text` TIMESERIES AUTO LIMIT 10"
              }
            ],
            "legend": {
              "enabled": true
            },
            "yAxisLeft": {
              "zero": true,
              "min": 0
            },
            "chartStyles": {
              "lineInterpolation": "smooth",
              "gradient": {
                "enabled": true
              }
            }
          }
        },
        {
          "title": "Error and warn volume by message (dev)",
          "layout": {
            "column": 7,
            "row": 2,
            "height": 3,
            "width": 6
          },
          "visualization": {
            "id": "viz.stacked-bar"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": ${account_id},
                "query": "FROM Log SELECT count(*) WHERE deployment.environment = 'dev' AND service.name = 'chats' AND `severity.text` IN ('ERROR', 'WARN') FACET message TIMESERIES AUTO LIMIT 10"
              }
            ],
            "legend": {
              "enabled": true
            },
            "yAxisLeft": {
              "zero": true,
              "min": 0
            },
            "chartStyles": {
              "gradient": {
                "enabled": true
              },
              "seriesOrder": "original",
              "stacked": {
                "enabled": true
              }
            }
          }
        },
        {
          "title": "Recent errors and warnings (dev)",
          "layout": {
            "column": 1,
            "row": 3,
            "height": 3,
            "width": 12
          },
          "visualization": {
            "id": "viz.table"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": ${account_id},
                "query": "FROM Log SELECT count(*) AS n, latest(message) AS sample, latest(`trace.id`) AS `sample trace` WHERE deployment.environment = 'dev' AND service.name = 'chats' AND `severity.text` IN ('ERROR', 'WARN') FACET message LIMIT 20"
              }
            ]
          }
        },
        {
          "title": "Slow RPCs over 500ms (dev)",
          "layout": {
            "column": 1,
            "row": 4,
            "height": 3,
            "width": 12
          },
          "visualization": {
            "id": "viz.table"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": ${account_id},
                "query": "FROM Span SELECT timestamp, name, `rpc.method`, duration.ms, `trace.id` WHERE deployment.environment = 'dev' AND service.name = 'chats' AND rpc.system = 'connect_rpc' AND duration.ms > 500 LIMIT 100"
              }
            ]
          }
        }
      ]
    }
  ]
}

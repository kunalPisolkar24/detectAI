            },
            "nrqlQueries": [
              {
                "accountId": ${account_id},
                "query": "FROM Metric SELECT average(nodejs_heap_space_size_used_bytes) / 1000000 AS `heap MB` WHERE deployment.environment = '${environment}' AND service = 'worker-analytics' TIMESERIES AUTO LIMIT 6"
              }
            ],
            "yAxisLeft": {
              "zero": true
            },
            "chartStyles": {

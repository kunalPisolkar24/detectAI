    {
      "name": "Analytics Logs",
      "description": "worker-analytics log stream, volume and error breakdown",
      "widgets": [
        {
          "title": "Warning and error log stream (latest 100)",
          "layout": {
            "column": 1,
            "row": 1,
            "height": 4,
            "width": 12
          },
          "visualization": {
            "id": "viz.table"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": ${account_id},
                "query": "FROM Log SELECT timestamp, `severity.text`, message, traceId, spanId WHERE service.name = 'worker-analytics' AND deployment.environment = '${environment}' AND (`severity.text` LIKE 'error' OR `severity.text` LIKE 'warn') LIMIT 100"
              }
            ]
          }
        },
        {
          "title": "Log volume by level (click legend to isolate)",
          "layout": {
            "column": 1,
            "row": 2,
            "height": 3,
            "width": 6
          },
          "visualization": {
            "id": "viz.area"
          },
          "rawConfiguration": {
            "legend": {
              "enabled": true
            },
            "nrqlQueries": [
              {
                "accountId": ${account_id},
                "query": "FROM Log SELECT count(*) WHERE service.name = 'worker-analytics' AND deployment.environment = '${environment}' FACET `severity.text` TIMESERIES AUTO LIMIT 10"
              }
            ],
            "yAxisLeft": {
              "zero": true
            },
            "chartStyles": {
              "lineInterpolation": "smooth",
              "gradient": {
                "enabled": true
              }
            }
          }
        },
        {
          "title": "Warnings and errors by message",
          "layout": {
            "column": 7,
            "row": 2,
            "height": 3,
            "width": 6
          },
          "visualization": {
            "id": "viz.stacked-bar"
          },
          "rawConfiguration": {
            "legend": {
              "enabled": true
            },
            "nrqlQueries": [
              {
                "accountId": ${account_id},
                "query": "FROM Log SELECT count(*) WHERE service.name = 'worker-analytics' AND deployment.environment = '${environment}' AND (`severity.text` LIKE 'error' OR `severity.text` LIKE 'warn') FACET message TIMESERIES AUTO LIMIT 10"
              }
            ],
            "facet": {
              "showOtherSeries": false
            },
            "chartStyles": {
              "gradient": {
                "enabled": true
              },
              "seriesOrder": "original",
              "stacked": {
                "enabled": true
              }
            }
          }
        },
        {
          "title": "Recent warnings and errors with trace links",
          "layout": {
            "column": 1,
            "row": 3,
            "height": 3,
            "width": 12
          },
          "visualization": {
            "id": "viz.table"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": ${account_id},
                "query": "FROM Log SELECT count(*) AS n, latest(message) AS sample, latest(traceId) AS `sample trace` WHERE service.name = 'worker-analytics' AND deployment.environment = '${environment}' AND (`severity.text` LIKE 'error' OR `severity.text` LIKE 'warn') FACET message LIMIT 20"
              }
            ]
          }
        },
        {
          "title": "Slow jobs over 1000ms",
          "layout": {
            "column": 1,
            "row": 4,
            "height": 3,
            "width": 12
          },
          "visualization": {
            "id": "viz.table"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": ${account_id},
                "query": "FROM Span SELECT timestamp, name, duration.ms, trace.id WHERE service.name = 'worker-analytics' AND deployment.environment = '${environment}' AND duration.ms > 1000 LIMIT 100"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "Cron",
      "description": "worker-cron: sweeps expired and paused subscriptions on a fixed interval",
      "widgets": [
        {
          "title": "Sweep ticks/min",
          "layout": {
            "column": 1,
            "row": 1,
            "height": 3,
            "width": 3
          },
          "visualization": {
            "id": "viz.gauge"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": ${account_id},
                "query": "FROM Metric SELECT rate(sum(worker_cron_loop_iterations_total), 1 minute) AS `ticks/min` WHERE deployment.environment = '${environment}' AND service = 'worker-cron'"
              }
            ],
            "limit": 1
          }
        },
        {
          "title": "Expiry lag (s)",
          "layout": {
            "column": 4,
            "row": 1,
            "height": 3,
            "width": 3
          },
          "visualization": {
            "id": "viz.gauge"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": ${account_id},
                "query": "FROM Metric SELECT latest(worker_cron_expiry_lag_seconds) AS `lag s` WHERE deployment.environment = '${environment}' AND service = 'worker-cron'"
              }
            ],
            "thresholds": {
              "alert": {
                "value": 3600
              },
              "warning": {
                "value": 900
              }
            },
            "limit": 86400
          }
        },
        {
          "title": "Expired backlog",
          "layout": {
            "column": 7,
            "row": 1,
            "height": 3,
            "width": 3
          },
          "visualization": {
            "id": "viz.gauge"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": ${account_id},
                "query": "FROM Metric SELECT latest(worker_cron_expired_backlog) AS `backlog` WHERE deployment.environment = '${environment}' AND service = 'worker-cron'"
              }
            ],
            "thresholds": {
              "alert": {
                "value": 100
              },
              "warning": {
                "value": 25
              }
            },
            "limit": 500
          }
        },
        {
          "title": "Stale events filtered (total)",
          "layout": {
            "column": 10,
            "row": 1,
            "height": 3,
            "width": 3
          },
          "visualization": {
            "id": "viz.gauge"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": ${account_id},
                "query": "FROM Metric SELECT sum(worker_cron_stale_events_filtered_total) AS `stale events` WHERE deployment.environment = '${environment}' AND service = 'worker-cron'"
              }
            ],
            "thresholds": {
              "alert": {
                "value": 1
              }
            },
            "limit": 50
          }
        },
        {
          "title": "Sweep duration p50/p95/p99",
          "layout": {
            "column": 1,
            "row": 2,
            "height": 3,
            "width": 6
          },
          "visualization": {
            "id": "viz.area"
          },
          "rawConfiguration": {
            "legend": {
              "enabled": true
            },
            "nrqlQueries": [
              {
                "accountId": ${account_id},
                "query": "FROM Span SELECT percentile(duration.ms, 50, 95, 99) WHERE service.name = 'worker-cron' AND deployment.environment = '${environment}' TIMESERIES AUTO"
              }
            ],
            "yAxisLeft": {
              "zero": true
            },
            "chartStyles": {
              "lineInterpolation": "smooth",
              "gradient": {
                "enabled": true
              }
            }
          }
        },
        {
          "title": "Batch size and expiry lag",
          "layout": {
            "column": 7,
            "row": 2,
            "height": 3,
            "width": 6
          },
          "visualization": {
            "id": "viz.area"
          },
          "rawConfiguration": {
            "legend": {
              "enabled": true
            },
            "nrqlQueries": [
              {
                "accountId": ${account_id},
                "query": "FROM Metric SELECT average(worker_cron_sweep_batch_size) AS `batch size` WHERE deployment.environment = '${environment}' AND service = 'worker-cron' TIMESERIES AUTO"
              }
            ],
            "yAxisLeft": {
              "zero": true
            },
            "chartStyles": {
              "lineInterpolation": "smooth",
              "gradient": {
                "enabled": true
              }
            }
          }
        },
        {
          "title": "Loop iterations by result",
          "layout": {
            "column": 1,
            "row": 3,
            "height": 3,
            "width": 6
          },
          "visualization": {
            "id": "viz.stacked-bar"
          },
          "rawConfiguration": {
            "legend": {
              "enabled": true
            },
            "nrqlQueries": [
              {
                "accountId": ${account_id},
                "query": "FROM Metric SELECT rate(sum(worker_cron_loop_iterations_total), 1 minute) AS `iterations/min` WHERE deployment.environment = '${environment}' AND service = 'worker-cron' FACET result TIMESERIES AUTO LIMIT 6"
              }
            ],
            "facet": {
              "showOtherSeries": false
            },
            "chartStyles": {
              "gradient": {
                "enabled": true
              },
              "seriesOrder": "original",
              "stacked": {
                "enabled": true
              }
            }
          }
        },
        {
          "title": "Subscription status distribution",
          "layout": {
            "column": 7,
            "row": 3,
            "height": 3,
            "width": 6
          },
          "visualization": {
            "id": "viz.area"
          },
          "rawConfiguration": {
            "legend": {
              "enabled": true
            },
            "nrqlQueries": [
              {
                "accountId": ${account_id},
                "query": "FROM Metric SELECT average(worker_cron_subscription_status) AS `subscriptions` WHERE deployment.environment = '${environment}' AND service = 'worker-cron' FACET status TIMESERIES AUTO LIMIT 8"
              }
            ],
            "yAxisLeft": {
              "zero": true
            },
            "chartStyles": {
              "lineInterpolation": "smooth",
              "gradient": {
                "enabled": true
              }
            }
          }
        },
        {
          "title": "Sweep skips and shutdown aborts",
          "layout": {
            "column": 1,
            "row": 4,
            "height": 3,
            "width": 6
          },
          "visualization": {
            "id": "viz.area"
          },
          "rawConfiguration": {
            "legend": {
              "enabled": true
            },
            "nrqlQueries": [
              {
                "accountId": ${account_id},
                "query": "FROM Metric SELECT rate(sum(worker_cron_sweep_skipped_total), 1 minute) AS `sweep skips/min` WHERE deployment.environment = '${environment}' AND service = 'worker-cron' TIMESERIES AUTO"
              },
              {
                "accountId": ${account_id},
                "query": "FROM Metric SELECT rate(sum(worker_cron_shutdown_aborts_total), 1 minute) AS `shutdown aborts/min` WHERE deployment.environment = '${environment}' AND service = 'worker-cron' TIMESERIES AUTO"
              }
            ],
            "yAxisLeft": {
              "zero": true
            },
            "chartStyles": {
              "lineInterpolation": "smooth",
              "gradient": {
                "enabled": true
              }
            }
          }
        },
        {
          "title": "Cache invalidation duration",
          "layout": {
            "column": 7,
            "row": 4,
            "height": 3,
            "width": 6
          },
          "visualization": {
            "id": "viz.area"
          },
          "rawConfiguration": {
            "legend": {
              "enabled": true
            },
            "nrqlQueries": [
              {
                "accountId": ${account_id},
                "query": "FROM Span SELECT percentile(duration.ms, 50, 95) WHERE service.name = 'worker-cron' AND deployment.environment = '${environment}' AND name LIKE '%cache%' TIMESERIES AUTO"
              }
            ],
            "yAxisLeft": {
              "zero": true
            },
            "chartStyles": {
              "lineInterpolation": "smooth",
              "gradient": {
                "enabled": true
              }
            }
          }
        },
        {
          "title": "Sweep outcomes and config",
          "layout": {
            "column": 1,
            "row": 5,
            "height": 4,
            "width": 12
          },
          "visualization": {
            "id": "viz.table"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": ${account_id},
                "query": "FROM Metric SELECT sum(worker_cron_loop_iterations_total) AS `iterations`, max(worker_cron_loop_iterations_total) AS `latest` WHERE deployment.environment = '${environment}' AND service = 'worker-cron' FACET result LIMIT 10"
              },
              {
                "accountId": ${account_id},
                "query": "FROM Metric SELECT latest(worker_cron_config) AS `config` WHERE deployment.environment = '${environment}' AND service = 'worker-cron' FACET param LIMIT 10"
              }
            ]
          }
        },
        {
          "title": "Worker container CPU % (of one core)",
          "layout": {
            "column": 1,
            "row": 6,
            "height": 3,
            "width": 6
          },
          "visualization": {
            "id": "viz.area"
          },
          "rawConfiguration": {
            "legend": {
              "enabled": true
            },
            "nrqlQueries": [
              {
                "accountId": ${account_id},
                "query": "FROM Metric SELECT average(`container.cpu.utilization`) AS `cpu` WHERE deployment.environment = '${environment}' AND `container.name` = 'worker_cron' TIMESERIES AUTO LIMIT 6"
              }

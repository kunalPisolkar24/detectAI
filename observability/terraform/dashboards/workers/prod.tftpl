{
  "name": "detectai-workers (${environment})",
  "description": "All workers: analytics consumer, cron sweeper, payments consumer. Queues: analytics.usage, payment_events. Sampler traceidratio 0.1 (analytics, payments), always_on (cron). Runbooks: services/workers/docs.",
  "permissions": "PUBLIC_READ_WRITE",
  "pages": [
    {
      "name": "Overview",
      "description": "Cross-worker health: throughput, errors, latency, broker connectivity, DLQ",
      "widgets": [
        {
          "title": "Messages/min (all workers)",
          "layout": {
            "column": 1,
            "row": 1,
            "height": 3,
            "width": 3
          },
          "visualization": {
            "id": "viz.gauge"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": ${account_id},
                "query": "FROM Metric SELECT rate(sum(worker_jobs_processed_total), 1 minute) AS `msgs/min` WHERE deployment.environment = '${environment}' AND service IN ('worker-analytics', 'worker-payments')"
              }
            ],
            "limit": 500
          }
        },
        {
          "title": "Error share (all workers)",
          "layout": {
            "column": 4,
            "row": 1,
            "height": 3,
            "width": 3
          },
          "visualization": {
            "id": "viz.gauge"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": ${account_id},
                "query": "FROM Metric SELECT 100 * sum(worker_job_errors_total) / (sum(worker_job_errors_total) + sum(worker_jobs_processed_total)) AS `error %` WHERE deployment.environment = '${environment}' AND service IN ('worker-analytics', 'worker-payments')"
              }
            ],
            "thresholds": {
              "alert": {
                "value": 2
              },
              "warning": {
                "value": 1
              }
            },
            "limit": 2
          }
        },
        {
          "title": "Dead-lettered (total)",
          "layout": {
            "column": 7,
            "row": 1,
            "height": 3,
            "width": 3
          },
          "visualization": {
            "id": "viz.gauge"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": ${account_id},
                "query": "FROM Metric SELECT sum(worker_dead_lettered_total) AS `dead letters` WHERE deployment.environment = '${environment}'"
              }
            ],
            "thresholds": {
              "alert": {
                "value": 1
              }
            },
            "limit": 20
          }
        },
        {
          "title": "Retries/min",
          "layout": {
            "column": 10,
            "row": 1,
            "height": 3,
            "width": 3
          },
          "visualization": {
            "id": "viz.gauge"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": ${account_id},
                "query": "FROM Metric SELECT rate(sum(worker_retry_total), 1 minute) AS `retries/min` WHERE deployment.environment = '${environment}'"
              }
            ],
            "thresholds": {
              "alert": {
                "value": 10
              },
              "warning": {
                "value": 3
              }
            },
            "limit": 50
          }
        },
        {
          "title": "RabbitMQ connected (min across workers)",
          "layout": {
            "column": 1,
            "row": 2,
            "height": 3,
            "width": 3
          },
          "visualization": {
            "id": "viz.gauge"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": ${account_id},
                "query": "FROM Metric SELECT min(rabbitmq_connection_status) AS `connected` WHERE deployment.environment = '${environment}' AND service IN ('worker-analytics', 'worker-payments')"
              }
            ],
            "thresholds": {
              "alert": {
                "value": 0.5
              }
            },
            "limit": 1
          }
        },
        {
          "title": "Cron expiry lag (s)",
          "layout": {
            "column": 4,
            "row": 2,
            "height": 3,
            "width": 3
          },
          "visualization": {
            "id": "viz.gauge"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": ${account_id},
                "query": "FROM Metric SELECT latest(worker_cron_expiry_lag_seconds) AS `lag s` WHERE deployment.environment = '${environment}' AND service = 'worker-cron'"
              }
            ],
            "thresholds": {
              "alert": {
                "value": 3600
              },
              "warning": {
                "value": 900
              }
            },
            "limit": 86400
          }
        },
        {
          "title": "Expired backlog",
          "layout": {
            "column": 7,
            "row": 2,
            "height": 3,
            "width": 3
          },
          "visualization": {
            "id": "viz.gauge"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": ${account_id},
                "query": "FROM Metric SELECT latest(worker_cron_expired_backlog) AS `backlog` WHERE deployment.environment = '${environment}' AND service = 'worker-cron'"
              }
            ],
            "thresholds": {
              "alert": {
                "value": 100
              },
              "warning": {
                "value": 25
              }
            },
            "limit": 500
          }
        },
        {
          "title": "Max eventloop lag (ms)",
          "layout": {
            "column": 10,
            "row": 2,
            "height": 3,
            "width": 3
          },
          "visualization": {
            "id": "viz.gauge"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": ${account_id},
                "query": "FROM Metric SELECT max(nodejs_eventloop_lag_seconds * 1000) AS `loop lag ms` WHERE deployment.environment = '${environment}'"
              }
            ],
            "thresholds": {
              "alert": {
                "value": 200
              },
              "warning": {
                "value": 50
              }
            },
            "limit": 2000
          }
        },
        {
          "title": "Throughput by worker",
          "layout": {
            "column": 1,
            "row": 3,
            "height": 3,
            "width": 6
          },
          "visualization": {
            "id": "viz.area"
          },
          "rawConfiguration": {
            "legend": {
              "enabled": true
            },
            "nrqlQueries": [
              {
                "accountId": ${account_id},
                "query": "FROM Metric SELECT rate(sum(worker_jobs_processed_total), 1 minute) AS `msgs/min` WHERE deployment.environment = '${environment}' FACET service TIMESERIES AUTO LIMIT 6"
              }
            ],
            "yAxisLeft": {
              "zero": true
            },
            "chartStyles": {
              "lineInterpolation": "smooth",
              "gradient": {
                "enabled": true
              }
            }
          }
        },
        {
          "title": "Errors by worker",
          "layout": {
            "column": 7,
            "row": 3,
            "height": 3,
            "width": 6
          },
          "visualization": {
            "id": "viz.area"
          },
          "rawConfiguration": {
            "legend": {
              "enabled": true
            },
            "nrqlQueries": [
              {
                "accountId": ${account_id},
                "query": "FROM Metric SELECT rate(sum(worker_job_errors_total), 1 minute) AS `errors/min` WHERE deployment.environment = '${environment}' FACET service TIMESERIES AUTO LIMIT 6"
              }
            ],
            "yAxisLeft": {
              "zero": true
            },
            "chartStyles": {
              "lineInterpolation": "smooth",
              "gradient": {
                "enabled": true
              }
            }
          }
        },
        {
          "title": "Job duration p50/p95/p99 (all workers)",
          "layout": {
            "column": 1,
            "row": 4,
            "height": 3,
            "width": 6
          },
          "visualization": {
            "id": "viz.area"
          },
          "rawConfiguration": {
            "legend": {
              "enabled": true
            },
            "nrqlQueries": [
              {
                "accountId": ${account_id},
                "query": "FROM Span SELECT percentile(duration.ms, 50, 95, 99) WHERE service.name LIKE 'worker-%' AND deployment.environment = '${environment}' TIMESERIES AUTO"
              }
            ],
            "yAxisLeft": {
              "zero": true
            },
            "chartStyles": {
              "lineInterpolation": "smooth",
              "gradient": {
                "enabled": true
              }
            }
          }
        },
        {
          "title": "Retries and dead letters/min",
          "layout": {
            "column": 7,
            "row": 4,
            "height": 3,
            "width": 6
          },
          "visualization": {
            "id": "viz.stacked-bar"
          },
          "rawConfiguration": {
            "legend": {
              "enabled": true
            },
            "nrqlQueries": [
              {
                "accountId": ${account_id},
                "query": "FROM Metric SELECT rate(sum(worker_retry_total), 1 minute) AS `retries/min` WHERE deployment.environment = '${environment}' TIMESERIES AUTO LIMIT 5"
              },
              {
                "accountId": ${account_id},
                "query": "FROM Metric SELECT rate(sum(worker_dead_lettered_total), 1 minute) AS `dead/min` WHERE deployment.environment = '${environment}' TIMESERIES AUTO LIMIT 5"
              }
            ],
            "facet": {
              "showOtherSeries": false
            },
            "chartStyles": {
              "gradient": {
                "enabled": true
              },
              "seriesOrder": "original",
              "stacked": {
                "enabled": true
              }
            }
          }
        },
        {
          "title": "Broker and cache connectivity",
          "layout": {
            "column": 1,
            "row": 5,
            "height": 3,
            "width": 6
          },
          "visualization": {
            "id": "viz.area"
          },
          "rawConfiguration": {
            "legend": {
              "enabled": true
            },
            "nrqlQueries": [
              {
                "accountId": ${account_id},
                "query": "FROM Metric SELECT average(rabbitmq_connection_status) AS `rabbitmq` WHERE deployment.environment = '${environment}' FACET service TIMESERIES AUTO LIMIT 6"
              },
              {
                "accountId": ${account_id},
                "query": "FROM Metric SELECT average(redis_connection_status) AS `redis` WHERE deployment.environment = '${environment}' FACET service TIMESERIES AUTO LIMIT 6"
              }
            ],
            "yAxisLeft": {
              "zero": true,
              "min": 0,
              "max": 1
            },
            "chartStyles": {
              "lineInterpolation": "smooth",
              "gradient": {
                "enabled": true
              }
            }
          }
        },
        {
          "title": "Duplicate events filtered/min (idempotency)",
          "layout": {
            "column": 7,
            "row": 5,
            "height": 3,
            "width": 6
          },
          "visualization": {
            "id": "viz.area"
          },
          "rawConfiguration": {
            "legend": {
              "enabled": true
            },
            "nrqlQueries": [
              {
                "accountId": ${account_id},
                "query": "FROM Metric SELECT rate(sum(worker_duplicate_events_total), 1 minute) AS `duplicates/min` WHERE deployment.environment = '${environment}' FACET service TIMESERIES AUTO LIMIT 6"
              }
            ],
            "yAxisLeft": {
              "zero": true
            },
            "chartStyles": {
              "lineInterpolation": "smooth",
              "gradient": {
                "enabled": true
              }
            }
          }
        },
        {
          "title": "Errors per worker and type",
          "layout": {
            "column": 1,
            "row": 6,
            "height": 4,
            "width": 6
          },
          "visualization": {
            "id": "viz.table"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": ${account_id},
                "query": "FROM Metric SELECT rate(sum(worker_job_errors_total), 1 minute) AS `errors/min`, sum(worker_job_errors_total) AS `total` WHERE deployment.environment = '${environment}' FACET service, job_type, error_type LIMIT 25"
              }
            ]
          }
        },
        {
          "title": "Messages processed by worker and type",
          "layout": {
            "column": 7,
            "row": 6,
            "height": 4,
            "width": 6
          },
          "visualization": {
            "id": "viz.table"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": ${account_id},
                "query": "FROM Metric SELECT rate(sum(worker_jobs_processed_total), 1 minute) AS `msgs/min`, sum(worker_jobs_processed_total) AS `total`, average(worker_message_size_bytes) AS `avg bytes` WHERE deployment.environment = '${environment}' FACET service, job_type LIMIT 25"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "Analytics",
      "description": "worker-analytics: consumes analytics.usage, dedupes, writes Usage",
      "widgets": [
        {
          "title": "Messages/min",
          "layout": {
            "column": 1,
            "row": 1,
            "height": 3,
            "width": 3
          },
          "visualization": {
            "id": "viz.gauge"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": ${account_id},
                "query": "FROM Metric SELECT rate(sum(worker_jobs_processed_total), 1 minute) AS `msgs/min` WHERE deployment.environment = '${environment}' AND service = 'worker-analytics'"
              }
            ],
            "limit": 300
          }
        },
        {
          "title": "Error share",
          "layout": {
            "column": 4,
            "row": 1,
            "height": 3,
            "width": 3
          },
          "visualization": {
            "id": "viz.gauge"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": ${account_id},
                "query": "FROM Metric SELECT 100 * sum(worker_job_errors_total) / (sum(worker_job_errors_total) + sum(worker_jobs_processed_total)) AS `error %` WHERE deployment.environment = '${environment}' AND service = 'worker-analytics'"
              }
            ],
            "thresholds": {
              "alert": {
                "value": 2
              },
              "warning": {
                "value": 1
              }
            },
            "limit": 2
          }
        },
        {
          "title": "Job p95",
          "layout": {
            "column": 7,
            "row": 1,
            "height": 3,
            "width": 3
          },
          "visualization": {
            "id": "viz.gauge"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": ${account_id},
                "query": "FROM Span SELECT percentile(duration.ms, 95) AS `p95 ms` WHERE service.name = 'worker-analytics' AND deployment.environment = '${environment}'"
              }
            ],
            "limit": 1000
          }
        },
        {
          "title": "Dead-lettered (total)",
          "layout": {
            "column": 10,
            "row": 1,
            "height": 3,
            "width": 3
          },
          "visualization": {
            "id": "viz.gauge"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": ${account_id},
                "query": "FROM Metric SELECT sum(worker_dead_lettered_total) AS `dead letters` WHERE deployment.environment = '${environment}' AND service = 'worker-analytics'"
              }
            ],
            "thresholds": {
              "alert": {
                "value": 1
              }
            },
            "limit": 20
          }
        },
        {
          "title": "Throughput and duplicates",
          "layout": {
            "column": 1,
            "row": 2,
            "height": 3,
            "width": 6
          },
          "visualization": {
            "id": "viz.area"
          },
          "rawConfiguration": {
            "legend": {
              "enabled": true
            },
            "nrqlQueries": [
              {
                "accountId": ${account_id},
                "query": "FROM Metric SELECT rate(sum(worker_jobs_processed_total), 1 minute) AS `msgs/min` WHERE deployment.environment = '${environment}' AND service = 'worker-analytics' TIMESERIES AUTO"
              },
              {
                "accountId": ${account_id},
                "query": "FROM Metric SELECT rate(sum(worker_cron_stale_events_filtered_total), 1 minute) AS `dupes/min` WHERE deployment.environment = '${environment}' AND service = 'worker-analytics' FACET reason TIMESERIES AUTO LIMIT 6"
              }
            ],
            "yAxisLeft": {
              "zero": true
            },
            "chartStyles": {
              "lineInterpolation": "smooth",
              "gradient": {
                "enabled": true
              }
            }
          }
        },
        {
          "title": "Job duration p50/p95/p99",
          "layout": {
            "column": 7,
            "row": 2,
            "height": 3,
            "width": 6
          },
          "visualization": {
            "id": "viz.area"
          },
          "rawConfiguration": {
            "legend": {
              "enabled": true
            },
            "nrqlQueries": [
              {
                "accountId": ${account_id},
                "query": "FROM Span SELECT percentile(duration.ms, 50, 95, 99) WHERE service.name = 'worker-analytics' AND deployment.environment = '${environment}' TIMESERIES AUTO"
              }
            ],
            "yAxisLeft": {
              "zero": true
            },
            "chartStyles": {
              "lineInterpolation": "smooth",
              "gradient": {
                "enabled": true
              }
            }
          }
        },
        {
          "title": "Errors by type",
          "layout": {
            "column": 1,
            "row": 3,
            "height": 3,
            "width": 6
          },
          "visualization": {
            "id": "viz.stacked-bar"
          },
          "rawConfiguration": {
            "legend": {
              "enabled": true
            },
            "nrqlQueries": [
              {
                "accountId": ${account_id},
                "query": "FROM Metric SELECT rate(sum(worker_job_errors_total), 1 minute) AS `errors/min` WHERE deployment.environment = '${environment}' AND service = 'worker-analytics' FACET error_type TIMESERIES AUTO LIMIT 8"
              }
            ],
            "facet": {
              "showOtherSeries": false
            },
            "chartStyles": {
              "gradient": {
                "enabled": true
              },
              "seriesOrder": "original",
              "stacked": {
                "enabled": true
              }
            }
          }
        },
        {
          "title": "Active jobs and instances",
          "layout": {
            "column": 7,
            "row": 3,
            "height": 3,
            "width": 6
          },
          "visualization": {
            "id": "viz.area"
          },
          "rawConfiguration": {
            "legend": {
              "enabled": true
            },
            "nrqlQueries": [
              {
                "accountId": ${account_id},
                "query": "FROM Metric SELECT average(worker_active_jobs) AS `active jobs` WHERE deployment.environment = '${environment}' AND service = 'worker-analytics' TIMESERIES AUTO"
              },
              {
                "accountId": ${account_id},
                "query": "FROM Metric SELECT average(worker_active_instances) AS `instances` WHERE deployment.environment = '${environment}' AND service = 'worker-analytics' TIMESERIES AUTO"
              }
            ],
            "yAxisLeft": {
              "zero": true
            },
            "chartStyles": {
              "lineInterpolation": "smooth",
              "gradient": {
                "enabled": true
              }
            }
          }
        },
        {
          "title": "Cache hit rate (dedup lookups)",
          "layout": {
            "column": 1,
            "row": 4,
            "height": 3,
            "width": 6
          },
          "visualization": {
            "id": "viz.gauge"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": ${account_id},
                "query": "FROM Metric SELECT 100 * sum(worker_cron_stale_events_filtered_total) / (sum(worker_cron_stale_events_filtered_total) + sum(worker_jobs_processed_total)) AS `dedup hit %` WHERE deployment.environment = '${environment}' AND service = 'worker-analytics'"
              }
            ],
            "thresholds": {
              "alert": {
                "value": 25
              },
              "warning": {
                "value": 10
              }
            },
            "limit": 2
          }
        },
        {
          "title": "Redis and RabbitMQ connectivity",
          "layout": {
            "column": 7,
            "row": 4,
            "height": 3,
            "width": 6
          },
          "visualization": {
            "id": "viz.area"
          },
          "rawConfiguration": {
            "legend": {
              "enabled": true
            },
            "nrqlQueries": [
              {
                "accountId": ${account_id},
                "query": "FROM Metric SELECT average(redis_connection_status) AS `redis` WHERE deployment.environment = '${environment}' AND service = 'worker-analytics' TIMESERIES AUTO"
              },
              {
                "accountId": ${account_id},
                "query": "FROM Metric SELECT average(rabbitmq_connection_status) AS `rabbitmq` WHERE deployment.environment = '${environment}' AND service = 'worker-analytics' TIMESERIES AUTO"
              }
            ],
            "yAxisLeft": {
              "zero": true,
              "min": 0,
              "max": 1
            },
            "chartStyles": {
              "lineInterpolation": "smooth",
              "gradient": {
                "enabled": true
              }
            }
          }
        },
        {
          "title": "Errors by type and job (cumulative)",
          "layout": {
            "column": 1,
            "row": 5,
            "height": 4,
            "width": 12
          },
          "visualization": {
            "id": "viz.table"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": ${account_id},
                "query": "FROM Metric SELECT sum(worker_job_errors_total) AS `errors`, max(worker_job_errors_total) AS `latest` WHERE deployment.environment = '${environment}' AND service = 'worker-analytics' FACET job_type, error_type LIMIT 25"
              }
            ]
          }
        },
        {
          "title": "Worker container CPU % (of one core)",
          "layout": {
            "column": 1,
            "row": 6,
            "height": 3,
            "width": 6
          },
          "visualization": {
            "id": "viz.area"
          },
          "rawConfiguration": {
            "legend": {
              "enabled": true
            },
            "nrqlQueries": [
              {
                "accountId": ${account_id},
                "query": "FROM Metric SELECT average(`container.cpu.utilization`) AS `cpu` WHERE deployment.environment = '${environment}' AND `container.name` = 'worker_analytics' TIMESERIES AUTO LIMIT 6"
              }
            ],
            "yAxisLeft": {
              "zero": true,
              "min": 0,
              "max": 100
            },
            "chartStyles": {
              "lineInterpolation": "smooth",
              "gradient": {
                "enabled": true
              }
            }
          }
        },
        {
          "title": "Worker container memory used (MB)",
          "layout": {
            "column": 7,
            "row": 6,
            "height": 3,
            "width": 6
          },
          "visualization": {
            "id": "viz.area"
          },
          "rawConfiguration": {
            "legend": {
              "enabled": true
            },
            "nrqlQueries": [
              {
                "accountId": ${account_id},
                "query": "FROM Metric SELECT average(container.memory.usage.total) / 1024 / 1024 AS `mem MB` WHERE deployment.environment = '${environment}' AND `container.name` = 'worker_analytics' TIMESERIES AUTO LIMIT 6"
              }
            ],
            "yAxisLeft": {
              "zero": true,
              "min": 0,
              "max": 100
            },
            "chartStyles": {
              "lineInterpolation": "smooth",
              "gradient": {
                "enabled": true
              }
            }
          }
        },
        {
          "title": "Worker container network rx/tx",
          "layout": {
            "column": 1,
            "row": 7,
            "height": 3,
            "width": 6
          },
          "visualization": {
            "id": "viz.area"
          },
          "rawConfiguration": {
            "legend": {
              "enabled": true
            },
            "nrqlQueries": [
              {
                "accountId": ${account_id},
                "query": "FROM Metric SELECT rate(sum(`container.network.io.usage.rx_bytes`), 1 minute) AS rx WHERE deployment.environment = '${environment}' AND `container.name` = 'worker_analytics' TIMESERIES AUTO LIMIT 6"
              },
              {
                "accountId": ${account_id},
                "query": "FROM Metric SELECT rate(sum(`container.network.io.usage.tx_bytes`), 1 minute) AS tx WHERE deployment.environment = '${environment}' AND `container.name` = 'worker_analytics' TIMESERIES AUTO LIMIT 6"
              }
            ],
            "yAxisLeft": {
              "zero": true,
              "min": 0
            },
            "chartStyles": {
              "lineInterpolation": "smooth",
              "gradient": {
                "enabled": true
              }
            }
          }
        },
        {
          "title": "Worker container CPU throttled",
          "layout": {
            "column": 7,
            "row": 7,
            "height": 3,
            "width": 6
          },
          "visualization": {
            "id": "viz.area"
          },
          "rawConfiguration": {
            "legend": {
              "enabled": true
            },
            "nrqlQueries": [
              {
                "accountId": ${account_id},
                "query": "FROM Metric SELECT rate(sum(`container.cpu.throttling_data.throttled_time`), 1 minute) AS `throttled ns/s` WHERE deployment.environment = '${environment}' AND `container.name` = 'worker_analytics' TIMESERIES AUTO LIMIT 6"
              }
            ],
            "yAxisLeft": {
              "zero": true,
              "min": 0
            },
            "chartStyles": {
              "lineInterpolation": "smooth",
              "gradient": {
                "enabled": true
              }
            }
          }
        },
        {
          "title": "Eventloop lag (ms)",
          "layout": {
            "column": 1,
            "row": 8,
            "height": 3,
            "width": 6
          },
          "visualization": {
            "id": "viz.area"
          },
          "rawConfiguration": {
            "legend": {
              "enabled": true
            },
            "nrqlQueries": [
              {
                "accountId": ${account_id},
                "query": "FROM Metric SELECT average(nodejs_eventloop_lag_seconds * 1000) AS `loop lag ms` WHERE deployment.environment = '${environment}' AND service = 'worker-analytics' TIMESERIES AUTO LIMIT 6"
              }
            ],
            "yAxisLeft": {
              "zero": true
            },
            "chartStyles": {
              "lineInterpolation": "smooth",
              "gradient": {
                "enabled": true
              }
            }
          }
        },
        {

        {
          "title": "Recent warnings and errors with trace links",
          "layout": {
            "column": 1,
            "row": 3,
            "height": 3,
            "width": 12
          },
          "visualization": {
            "id": "viz.table"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": ${account_id},
                "query": "FROM Log SELECT count(*) AS n, latest(message) AS sample, latest(traceId) AS `sample trace` WHERE service.name = 'worker-cron' AND deployment.environment = '${environment}' AND (`severity.text` LIKE 'error' OR `severity.text` LIKE 'warn') FACET message LIMIT 20"
              }
            ]
          }
        },
        {
          "title": "Sweep messages (latest 100)",
          "layout": {
            "column": 1,
            "row": 4,
            "height": 3,
            "width": 12
          },
          "visualization": {
            "id": "viz.table"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": ${account_id},
                "query": "FROM Log SELECT timestamp, `severity.text`, message, traceId WHERE service.name = 'worker-cron' AND deployment.environment = '${environment}' AND (message LIKE '%sweep%' OR message LIKE '%subscription%' OR message LIKE '%expired%' OR message LIKE '%paused%') LIMIT 100"
              }
            ]
          }
        }
      ]
    },

    {
      "name": "Infra",
      "description": "Datastores and broker the workers depend on: Postgres (pool + exporter), Redis users + events (exporter), RabbitMQ (app metrics + broker exporter). Row 1 gauges: pool waiting, pool connections open (POOL_MAX=5), Redis and RabbitMQ disconnected (1 = a client is down). Rows 2-3 Postgres, rows 4-5 Redis, rows 6-7 RabbitMQ, rows 8-9 tables. Worker-side widgets read the worker /metrics (service LIKE 'worker-%') and need the collector scrape jobs worker-analytics:7001, worker-cron:7002, worker-payments:7003. Broker-side widgets need the rabbitmq exporter pointed at the management API (RABBITMQ_MGMT_URL); until then they stay empty.",
      "widgets": [
        {
          "title": "Postgres pool waiting (max)",
          "layout": {
            "column": 1,
            "row": 1,
            "height": 3,
            "width": 3
          },
          "visualization": {
            "id": "viz.gauge"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": ${account_id},
                "query": "FROM Metric SELECT max(db_pool_connections) AS `waiting` WHERE deployment.environment = '${environment}' AND service LIKE 'worker-%' AND state = 'waiting'"
              }
            ],
            "thresholds": {
              "alert": {
                "value": 5
              },
              "warning": {
                "value": 2
              }
            }
          }
        },
        {
          "title": "Postgres pool connections open (max)",
          "layout": {
            "column": 4,
            "row": 1,
            "height": 3,
            "width": 3
          },
          "visualization": {
            "id": "viz.gauge"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": ${account_id},
                "query": "FROM Metric SELECT max(db_pool_connections) AS `open` WHERE deployment.environment = '${environment}' AND service LIKE 'worker-%' AND state = 'total'"
              }
            ],
            "thresholds": {
              "alert": {
                "value": 5
              },
              "warning": {
                "value": 4
              }
            }
          }
        },
        {
          "title": "Redis disconnected (worst client)",
          "layout": {
            "column": 7,
            "row": 1,
            "height": 3,
            "width": 3
          },
          "visualization": {
            "id": "viz.gauge"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": ${account_id},
                "query": "FROM Metric SELECT 1 - min(redis_connection_status) AS `disconnected` WHERE deployment.environment = '${environment}' AND service LIKE 'worker-%'"
              }
            ],
            "thresholds": {
              "alert": {
                "value": 1
              },
              "warning": {
                "value": 0.5
              }
            }
          }
        },
        {
          "title": "RabbitMQ disconnected (worst worker)",
          "layout": {
            "column": 10,
            "row": 1,
            "height": 3,
            "width": 3
          },
          "visualization": {
            "id": "viz.gauge"
          },
          "rawConfiguration": {
            "nrqlQueries": [
              {
                "accountId": ${account_id},
                "query": "FROM Metric SELECT 1 - min(rabbitmq_connection_status) AS `disconnected` WHERE deployment.environment = '${environment}' AND service LIKE 'worker-%'"
              }
            ],
            "thresholds": {
              "alert": {
                "value": 1
              },
              "warning": {
                "value": 0.5
              }
            }
          }
        },
        {
          "title": "Postgres pool by state (per worker)",
          "layout": {
            "column": 1,
            "row": 2,
            "height": 3,
            "width": 4
          },
          "visualization": {
            "id": "viz.area"
          },
          "rawConfiguration": {
            "legend": {
              "enabled": true
            },
            "nrqlQueries": [
              {
                "accountId": ${account_id},
                "query": "FROM Metric SELECT average(db_pool_connections) AS `connections` WHERE deployment.environment = '${environment}' AND service LIKE 'worker-%' FACET service, state TIMESERIES AUTO LIMIT 20"
              }
            ],
            "yAxisLeft": {
              "zero": true
            },
            "chartStyles": {
              "lineInterpolation": "smooth",
              "gradient": {
                "enabled": true
              }
            }
          }
        },
        {
          "title": "Postgres sweep transaction duration (committed/rolled back)",
          "layout": {
            "column": 5,
            "row": 2,
            "height": 3,
            "width": 4
          },
          "visualization": {
            "id": "viz.area"
          },
          "rawConfiguration": {
            "legend": {
              "enabled": true
            },
            "nrqlQueries": [
              {
                "accountId": ${account_id},
                "query": "FROM Metric SELECT average(worker_cron_db_transaction_duration_seconds) AS `tx s` WHERE deployment.environment = '${environment}' AND service LIKE 'worker-%' FACET result TIMESERIES AUTO LIMIT 5"
              }
            ],
            "yAxisLeft": {
              "zero": true
            },
            "chartStyles": {
              "lineInterpolation": "smooth",
              "gradient": {
                "enabled": true
              }
            }
          }

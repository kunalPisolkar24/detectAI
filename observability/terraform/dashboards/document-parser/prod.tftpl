{
  "name": "detectai-document-parser (${environment})",
  "description": "FastAPI text extraction: uploads, pages, durations, in-flight. service.name = document-parser. :8000.",
  "permissions": "PUBLIC_READ_WRITE",
  "pages": [
    {
      "name": "Document parser",
      "description": "Upload RED, extraction duration, in-flight",
      "widgets": [
        {
          "title": "Uploads/min",
          "layout": { "column": 1, "row": 2, "height": 3, "width": 3 },
          "visualization": { "id": "viz.gauge" },
          "rawConfiguration": {
            "nrqlQueries": [
              { "accountId": ${account_id}, "query": "FROM Span SELECT rate(count(*), 1 minute) AS `uploads/min` WHERE service.name = 'document-parser' AND deployment.environment = '${environment}' AND span.kind = 'server' AND http.route = '/api/v1/extract'" }
            ],
            "limit": 200
          }
        },
        {
          "title": "Error share",
          "layout": { "column": 4, "row": 2, "height": 3, "width": 3 },
          "visualization": { "id": "viz.gauge" },
          "rawConfiguration": {
            "nrqlQueries": [
              { "accountId": ${account_id}, "query": "FROM Span SELECT percentage(count(*), WHERE error = true) AS `error %` WHERE service.name = 'document-parser' AND deployment.environment = '${environment}' AND span.kind = 'server'" }
            ],
            "thresholds": { "alert": { "value": 2 }, "warning": { "value": 1 } },
            "limit": 2
          }
        },
        {
          "title": "Extract p95",
          "layout": { "column": 7, "row": 2, "height": 3, "width": 3 },
          "visualization": { "id": "viz.gauge" },
          "rawConfiguration": {
            "nrqlQueries": [
              { "accountId": ${account_id}, "query": "FROM Span SELECT percentile(duration.ms, 95) AS `p95 ms` WHERE service.name = 'document-parser' AND deployment.environment = '${environment}' AND span.kind = 'server' AND http.route = '/api/v1/extract'" }
            ],
            "limit": 1500
          }
        },
        {
          "title": "Timeouts",
          "layout": { "column": 1, "row": 3, "height": 3, "width": 6 },
          "visualization": { "id": "viz.gauge" },
          "rawConfiguration": {
            "nrqlQueries": [
              { "accountId": ${account_id}, "query": "FROM Metric SELECT sum(extraction_timeouts_total) AS timeouts WHERE deployment.environment = '${environment}'" }
            ],
            "thresholds": { "alert": { "value": 5 } },
            "limit": 5
          }
        },
        {
          "title": "Extract p99",
          "layout": { "column": 10, "row": 2, "height": 3, "width": 3 },
          "visualization": { "id": "viz.gauge" },
          "rawConfiguration": {
            "nrqlQueries": [
              { "accountId": ${account_id}, "query": "FROM Span SELECT percentile(duration.ms, 99) AS `p99 ms` WHERE service.name = 'document-parser' AND deployment.environment = '${environment}' AND span.kind = 'server' AND http.route = '/api/v1/extract'" }
            ],
            "limit": 3000
          }
        },
        {
          "title": "Server latency p50/p95/p99",
          "layout": { "column": 1, "row": 4, "height": 3, "width": 12 },
          "visualization": { "id": "viz.area" },
          "rawConfiguration": {
            "legend": { "enabled": true },
            "nrqlQueries": [
              { "accountId": ${account_id}, "query": "FROM Span SELECT percentile(duration.ms, 50, 95, 99) WHERE service.name = 'document-parser' AND deployment.environment = '${environment}' AND span.kind = 'server' AND http.route = '/api/v1/extract' TIMESERIES AUTO" }
            ],
            "yAxisLeft": { "zero": true },
            "chartStyles": { "lineInterpolation": "smooth", "gradient": { "enabled": true } }
          }
        },
        {
          "title": "Extraction duration — pdf",
          "layout": { "column": 1, "row": 5, "height": 3, "width": 4 },
          "visualization": { "id": "viz.area" },
          "rawConfiguration": {
            "legend": { "enabled": true },
            "nrqlQueries": [
              { "accountId": ${account_id}, "query": "FROM Span SELECT percentile(duration.ms, 50, 95, 99) WHERE service.name = 'document-parser' AND deployment.environment = '${environment}' AND name = 'extraction' AND mime_type = 'application/pdf' TIMESERIES AUTO" }
            ],
            "yAxisLeft": { "zero": true },
            "chartStyles": { "lineInterpolation": "smooth", "gradient": { "enabled": true } }
          }
        },
        {
          "title": "Extraction duration — docx",
          "layout": { "column": 5, "row": 5, "height": 3, "width": 4 },
          "visualization": { "id": "viz.area" },
          "rawConfiguration": {
            "legend": { "enabled": true },
            "nrqlQueries": [
              { "accountId": ${account_id}, "query": "FROM Span SELECT percentile(duration.ms, 50, 95, 99) WHERE service.name = 'document-parser' AND deployment.environment = '${environment}' AND name = 'extraction' AND mime_type = 'application/vnd.openxmlformats-officedocument.wordprocessingml.document' TIMESERIES AUTO" }
            ],
            "yAxisLeft": { "zero": true },
            "chartStyles": { "lineInterpolation": "smooth", "gradient": { "enabled": true } }
          }
        },
        {
          "title": "Extraction duration — txt",
          "layout": { "column": 9, "row": 5, "height": 3, "width": 4 },
          "visualization": { "id": "viz.area" },
          "rawConfiguration": {
            "legend": { "enabled": true },
            "nrqlQueries": [
              { "accountId": ${account_id}, "query": "FROM Span SELECT percentile(duration.ms, 50, 95, 99) WHERE service.name = 'document-parser' AND deployment.environment = '${environment}' AND name = 'extraction' AND mime_type = 'text/plain' TIMESERIES AUTO" }
            ],
            "yAxisLeft": { "zero": true },
            "chartStyles": { "lineInterpolation": "smooth", "gradient": { "enabled": true } }
          }
        },
        {
          "title": "Status codes",
          "layout": { "column": 7, "row": 6, "height": 3, "width": 6 },
          "visualization": { "id": "viz.stacked-bar" },
          "rawConfiguration": {
            "legend": { "enabled": true },
            "nrqlQueries": [
              { "accountId": ${account_id}, "query": "FROM Span SELECT count(*) WHERE service.name = 'document-parser' AND deployment.environment = '${environment}' AND span.kind = 'server' FACET `http.status_code` TIMESERIES AUTO LIMIT 10" }
            ],
            "facet": { "showOtherSeries": false },
            "chartStyles": { "gradient": { "enabled": true }, "seriesOrder": "original", "stacked": { "enabled": true } }
          }
        },
        {
          "title": "Slowest extractions",
          "layout": { "column": 1, "row": 7, "height": 3, "width": 6 },
          "visualization": { "id": "viz.table" },
          "rawConfiguration": {
            "nrqlQueries": [
              { "accountId": ${account_id}, "query": "FROM Span SELECT max(duration.ms) AS `max ms`, average(duration.ms) AS `avg ms`, count(*) WHERE service.name = 'document-parser' AND deployment.environment = '${environment}' AND name = 'extraction' FACET cases(WHERE mime_type LIKE '%pdf%' AS 'pdf', WHERE mime_type LIKE '%officedocument%' AS 'docx', WHERE mime_type LIKE '%plain%' AS 'txt') LIMIT 20" }
            ]
          }
        },
        {
          "title": "Average request size by mime",
          "layout": { "column": 7, "row": 7, "height": 3, "width": 6 },
          "visualization": { "id": "viz.bar" },
          "rawConfiguration": {
            "legend": { "enabled": true },
            "nrqlQueries": [
              { "accountId": ${account_id}, "query": "FROM Span SELECT average(document_size_bytes) AS `avg bytes` WHERE service.name = 'document-parser' AND deployment.environment = '${environment}' AND name = 'extraction' FACET cases(WHERE mime_type = 'application/pdf' AS 'pdf', WHERE mime_type = 'application/vnd.openxmlformats-officedocument.wordprocessingml.document' AS 'docx', WHERE mime_type = 'text/plain' AS 'txt') LIMIT 20" }
            ]
          }
        },
        {
          "title": "In-flight + readiness 503s",
          "layout": { "column": 7, "row": 3, "height": 3, "width": 6 },
          "visualization": { "id": "viz.area" },
          "rawConfiguration": {
            "legend": { "enabled": true },
            "nrqlQueries": [
              { "accountId": ${account_id}, "query": "FROM Metric SELECT average(in_flight_requests) AS `in-flight` WHERE deployment.environment = '${environment}' TIMESERIES 1 minute" },
              { "accountId": ${account_id}, "query": "FROM Span SELECT count(*) AS `readiness 503s` WHERE service.name = 'document-parser' AND deployment.environment = '${environment}' AND span.kind = 'server' AND `http.status_code` = '503' AND (http.route = '/api/v1/ready' OR http.route = '/api/v1/health') TIMESERIES AUTO" }
            ],
            "yAxisLeft": { "zero": true, "min": 0 },
            "chartStyles": { "lineInterpolation": "smooth", "gradient": { "enabled": true } }
          }
        },
        {
          "title": "Extraction failures by type",
          "layout": { "column": 1, "row": 6, "height": 3, "width": 6 },
          "visualization": { "id": "viz.stacked-bar" },
          "rawConfiguration": {
            "legend": { "enabled": true },
            "nrqlQueries": [
              { "accountId": ${account_id}, "query": "FROM Metric SELECT sum(extraction_failures_total) AS failures WHERE deployment.environment = '${environment}' FACET error_type TIMESERIES AUTO LIMIT 10" }
            ],
            "facet": { "showOtherSeries": false },
            "chartStyles": { "gradient": { "enabled": true }, "seriesOrder": "original", "stacked": { "enabled": true } }
          }
        },
        {
          "title": "Rejections and timeouts",
          "layout": { "column": 1, "row": 8, "height": 3, "width": 6 },
          "visualization": { "id": "viz.area" },
          "rawConfiguration": {
            "legend": { "enabled": true },
            "nrqlQueries": [
              { "accountId": ${account_id}, "query": "FROM Metric SELECT rate(sum(rejected_uploads_total), 1 minute) AS `rejections/min` WHERE deployment.environment = '${environment}' FACET reason TIMESERIES AUTO LIMIT 10" },
              { "accountId": ${account_id}, "query": "FROM Metric SELECT rate(sum(extraction_timeouts_total), 1 minute) AS `timeouts/min` WHERE deployment.environment = '${environment}' FACET cases(WHERE mime_type = 'text/plain' AS 'txt', WHERE mime_type = 'application/pdf' AS 'pdf', WHERE mime_type = 'application/vnd.openxmlformats-officedocument.wordprocessingml.document' AS 'docx') TIMESERIES AUTO LIMIT 10" }
            ],
            "yAxisLeft": { "zero": true },
            "chartStyles": { "lineInterpolation": "smooth", "gradient": { "enabled": true } }
          }
        },
        {
          "title": "Service versions reporting",
          "layout": { "column": 7, "row": 8, "height": 3, "width": 6 },
          "visualization": { "id": "viz.table" },
          "rawConfiguration": {
            "nrqlQueries": [
              { "accountId": ${account_id}, "query": "FROM Span SELECT count(*) AS spans FACET service.name, service.version WHERE deployment.environment = '${environment}' AND service.name = 'document-parser' LIMIT 20" }
            ]
          }
        }
      ]
    },
    {
      "name": "Logs",
      "description": "Error-first log stream plus volume and slow requests",
      "widgets": [
        {
          "title": "Error log stream (latest 100)",
          "layout": { "column": 1, "row": 2, "height": 4, "width": 12 },
          "visualization": { "id": "viz.table" },
          "rawConfiguration": {
            "nrqlQueries": [
              { "accountId": ${account_id}, "query": "FROM Log SELECT timestamp, `severity.text`, message, path, status_code, `trace.id` WHERE service.name = 'document-parser' AND deployment.environment = '${environment}' AND `severity.text` = 'ERROR' LIMIT 100" }
            ]
          }
        },
        {
          "title": "Log volume by level (click legend to isolate)",
          "layout": { "column": 1, "row": 3, "height": 3, "width": 6 },
          "visualization": { "id": "viz.area" },
          "rawConfiguration": {
            "legend": { "enabled": true },
            "nrqlQueries": [
              { "accountId": ${account_id}, "query": "FROM Log SELECT count(*) WHERE service.name = 'document-parser' AND deployment.environment = '${environment}' FACET `severity.text` TIMESERIES AUTO LIMIT 10" }
            ],
            "yAxisLeft": { "zero": true },
            "chartStyles": { "lineInterpolation": "smooth", "gradient": { "enabled": true } }
          }
        },
        {
          "title": "Errors by path",
          "layout": { "column": 7, "row": 3, "height": 3, "width": 6 },
          "visualization": { "id": "viz.stacked-bar" },
          "rawConfiguration": {
            "legend": { "enabled": true },
            "nrqlQueries": [
              { "accountId": ${account_id}, "query": "FROM Log SELECT count(*) WHERE service.name = 'document-parser' AND deployment.environment = '${environment}' AND `severity.text` = 'ERROR' FACET path TIMESERIES AUTO" }
            ],
            "facet": { "showOtherSeries": false },
            "chartStyles": { "gradient": { "enabled": true }, "seriesOrder": "original", "stacked": { "enabled": true } }
          }
        },
        {
          "title": "Recent parser errors",
          "layout": { "column": 1, "row": 4, "height": 3, "width": 12 },
          "visualization": { "id": "viz.table" },
          "rawConfiguration": {
            "nrqlQueries": [
              { "accountId": ${account_id}, "query": "FROM Log SELECT count(*) AS n, latest(message) AS sample, latest(`trace.id`) AS `sample trace` WHERE service.name = 'document-parser' AND deployment.environment = '${environment}' AND `severity.text` = 'ERROR' FACET path LIMIT 20" }
            ]
          }
        },
        {
          "title": "Slow requests over 1500ms",
          "layout": { "column": 1, "row": 5, "height": 3, "width": 12 },
          "visualization": { "id": "viz.table" },
          "rawConfiguration": {
            "nrqlQueries": [
              { "accountId": ${account_id}, "query": "FROM Log SELECT timestamp, message, path, duration_ms, status_code, `trace.id` WHERE service.name = 'document-parser' AND deployment.environment = '${environment}' AND duration_ms > 1500 LIMIT 100" }
            ]
          }
        }
      ]
    }
  ]
}

# Preview mode — frontend-only, no backend required
# Copy to .env and run with preview scripts, or use compose.preview.yml
# NOTE: set BOTH flags. NEXT_PUBLIC_* is inlined at build time for the
# browser bundle; PREVIEW_MODE is read at runtime on the server so
# `next start` works even if the build cache is stale.

NEXT_PUBLIC_PREVIEW_MODE=true
PREVIEW_MODE=true
SKIP_ENV_VALIDATION=true

# NextAuth (any random string, min 1 char; 32+ recommended for production)
NEXTAUTH_SECRET=preview-secret-change-me-32-chars-min
NEXTAUTH_URL=http://localhost:3000

# Cloudflare Turnstile test keys that always pass without real verification
# See https://developers.cloudflare.com/turnstile/troubleshooting/testing/
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x00000000000000000000AA

# Paddle stub (not used in preview, but required for build)
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=dummy

# Dummy backends — ignored in preview (set to satisfy types if validation not skipped)
DATABASE_URL=postgresql://preview:preview@localhost:5432/preview
DATABASE_URL_REPLICA=postgresql://preview:preview@localhost:5432/preview
REDIS_MODE=sentinel
REDIS_SENTINELS=localhost:26379
REDIS_MASTER_NAME=mymaster
REDIS_USAGE_URL=redis://localhost:6379
FILE_EXTRACTOR_API_URL=http://localhost:8080
AI_SERVICE_URL=localhost:50051
AI_SERVICE_API_KEY=dummy
CHAT_SERVICE_URL=localhost:50051
PAYMENT_GATEWAY_URL=http://payment-gateway:8080
RABBITMQ_URL=amqp://guest:guest@localhost:5672

GOOGLE_ID=dummy
GOOGLE_SECRET=dummy
GITHUB_ID=dummy
GITHUB_SECRET=dummy

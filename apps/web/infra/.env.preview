# Preview mode — frontend-only, no backend required.
# Single flick: PREVIEW=true derives the legacy PREVIEW_MODE /
# NEXT_PUBLIC_PREVIEW_MODE flags (Dockerfile, makefile) and every other value
# below is only a backstop — lib/config/env.ts supplies the same canned
# defaults in code and ignores passed-in values when PREVIEW=true.
# Used via: `make preview` (i.e. docker compose --env-file infra/.env.preview
# -f infra/compose.yml up --build --no-deps frontend)
PREVIEW=true
PREVIEW_MODE=true
NEXT_PUBLIC_PREVIEW_MODE=true

PORT_FRONTEND=3000

# NextAuth (any random string, min 1 char; 32+ recommended for production)
NEXTAUTH_SECRET=preview-secret-for-docker-only-32chars
NEXTAUTH_URL=http://localhost:3000

# Cloudflare Turnstile test keys that always pass without real verification
# See https://developers.cloudflare.com/turnstile/troubleshooting/testing/
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x00000000000000000000AA

# Paddle stub (not used in preview, but required for build)
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=dummy

# Dummy backends — ignored in preview (all integrations are mocked)
NODE_ENV=production
LOG_LEVEL=info
DATABASE_URL=postgresql://preview:preview@localhost:5432/preview
DATABASE_URL_REPLICA=postgresql://preview:preview@localhost:5432/preview
REDIS_MODE=sentinel
REDIS_SENTINELS=localhost:26379
REDIS_MASTER_NAME=mymaster
REDIS_URL=redis://:preview@redis-app:6379
REDIS_PASSWORD=preview
REDIS_USAGE_MODE=standalone
REDIS_USAGE_PASSWORD=preview
REDIS_USAGE_URL=redis://localhost:6379
INTERNAL_API_KEY=dummy
PADDLE_API_KEY=dummy
PADDLE_WEBHOOK_SECRET=dummy
FILE_EXTRACTOR_API_URL=http://localhost:8080
AI_SERVICE_URL=localhost:50051
AI_SERVICE_API_KEY=dummy
CHAT_SERVICE_URL=localhost:50051
PAYMENT_GATEWAY_URL=http://payment-gateway:8080
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Included datastore atoms never start in preview (--no-deps), but their
# variables must still interpolate — dummies below keep renders clean.
POSTGRES_USER=preview
POSTGRES_PASSWORD=preview
POSTGRES_DB=preview
POSTGRES_PORT=5432
REDIS_PASSWORD=preview
REDIS_PORT=6379

GOOGLE_ID=dummy
GOOGLE_SECRET=dummy
GITHUB_ID=dummy
GITHUB_SECRET=dummy

# Web serving base — copy to apps/web/.env and adjust secrets.
#   cp infra/.env.example ../../.env   # from apps/web/infra, or:
#   cp apps/web/infra/.env.example apps/web/.env   # from repo root
# `make start` loads apps/web/.env (fails fast if missing). Shell-exported
# variables win over this file. Preview and load testing need no env file:
# preview runs on PREVIEW=true alone (canned defaults live in
# lib/config/env.ts); load values are fixed inline in the makefile.
PORT_FRONTEND=3000

# Canonical preview switch — keep false for serving.
PREVIEW=false
PREVIEW_MODE=false
NEXT_PUBLIC_PREVIEW_MODE=false

NODE_ENV=production
LOG_LEVEL=info

# Datastores (standalone postgres + user redis, always started with the stack)
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=detect_ai
POSTGRES_PORT=5432
DATABASE_URL=postgresql://user:password@postgres:5432/detect_ai
DATABASE_URL_REPLICA=postgresql://user:password@postgres:5432/detect_ai
REDIS_MODE=standalone
REDIS_URL=redis://:user_cache_password@redis-app:6379
REDIS_PASSWORD=user_cache_password
REDIS_MASTER_NAME=mymaster
REDIS_SENTINELS=redis-sentinel-1:26379
REDIS_USAGE_MODE=standalone
USE_REDIS_CLUSTER=false
REDIS_USAGE_URL=redis://:user_cache_password@redis-app:6379
REDIS_USAGE_PASSWORD=user_cache_password

# NextAuth
NEXTAUTH_SECRET=change-me-to-a-random-32-char-string
NEXTAUTH_URL=http://localhost:3000

# OAuth (fill in for real logins; blank disables at runtime)
GITHUB_ID=
GITHUB_SECRET=
GOOGLE_ID=
GOOGLE_SECRET=

# Cloudflare Turnstile (fill in; blank fails verification at runtime)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Paddle (fill in for real payments)
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=
PADDLE_API_KEY=

# Backend services (defaults point at the root local stack)
PAYMENT_GATEWAY_URL=http://payment-gateway:8080
INTERNAL_API_KEY=internal-secret-key
AI_SERVICE_URL=ai-service:50051
AI_SERVICE_API_KEY=dev-secret-key
CHAT_SERVICE_URL=chat-service:50051
FILE_EXTRACTOR_API_URL=http://document-parser:8000
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# Web serving base — copy to apps/web/.env and adjust secrets.
#   cp .env.example .env   # from apps/web
# Lives at the app root (not in infra/) so Prisma, Next.js, and the
# makefile all read the same file — one place, no duplicates.
# `make start` loads .env (fails fast if missing). Shell-exported
# variables win over this file. Preview and load testing need no env file:
# preview runs on PREVIEW=true alone (canned defaults live in
# lib/config/env.ts); load values are fixed inline in the makefile.
PORT_FRONTEND=3000

# Canonical preview switch — keep false for serving.
PREVIEW=false
PREVIEW_MODE=false
NEXT_PUBLIC_PREVIEW_MODE=false

NODE_ENV=production
LOG_LEVEL=info

# Datastores (standalone postgres + user redis, always started with the stack)
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=detect_ai
POSTGRES_PORT=5432
DATABASE_URL=postgresql://user:password@postgres:5432/detect_ai
DATABASE_URL_REPLICA=postgresql://user:password@postgres:5432/detect_ai
REDIS_MODE=standalone
REDIS_URL=redis://:user_cache_password@redis-app:6379
REDIS_PASSWORD=user_cache_password
REDIS_MASTER_NAME=mymaster
REDIS_SENTINELS=redis-sentinel-1:26379
# Usage counters + analytics dedup live in redis-cache (REDIS_URL).
# REDIS_USAGE_* removed (2 Redis: redis-cache + redis-events Paddle-only).

# NextAuth
NEXTAUTH_SECRET=change-me-to-a-random-32-char-string
NEXTAUTH_URL=http://localhost:3000

# OAuth (mock values disable providers at runtime; fill in for real logins)
GITHUB_ID=mock-github-client-id-not-configured
GITHUB_SECRET=mock-github-client-secret-not-configured
GOOGLE_ID=mock-google-client-id-not-configured
GOOGLE_SECRET=mock-google-client-secret-not-configured

# Cloudflare Turnstile test keys that always pass (fill in for real keys)
# See https://developers.cloudflare.com/turnstile/troubleshooting/testing/
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x00000000000000000000AA

# Paddle (mock values disable real payments; fill in for real billing)
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=mock-paddle-client-token-not-configured
PADDLE_WEBHOOK_SECRET=mock-paddle-webhook-secret-not-configured
PADDLE_API_KEY=mock-paddle-api-key-not-configured

# Backend services (defaults point at the root local stack)
PAYMENT_GATEWAY_URL=http://payment-gateway:8080
INTERNAL_API_KEY=internal-secret-key
AI_SERVICE_URL=ai-service:50051
AI_SERVICE_API_KEY=dev-secret-key
CHAT_SERVICE_URL=chat-service:50051
FILE_EXTRACTOR_API_URL=http://document-parser:8000
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

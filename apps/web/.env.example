# Web — dev compose env (ENV_TYPE=dev). Copy to apps/web/.env and adjust secrets:
#   cp .env.example .env   # from apps/web
# Lives at the app root (not in infra/) so Prisma, Next.js, and the
# makefile all read the same file — one place, no duplicates.
# `make start` loads .env (fails fast if missing). Shell-exported vars win.
# Preview needs no env file: `make preview` runs on ENV_TYPE=preview alone
# (canned defaults live in lib/config/schema.ts). Prod ignores this file
# and hydrates from AWS (see below).
PORT_FRONTEND=3000

ENV_TYPE=dev

NODE_ENV=production
LOG_LEVEL=info
DB_POOL_MAX=5

# Datastores (standalone postgres + user redis, always started with the stack)
# For local docker, REPLICA equals primary. For prod, REPLICA is the Aurora reader endpoint
# from AWS Secrets Manager detectai/pg/urls (injected at runtime, not here).
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=detect_ai
POSTGRES_PORT=5432
DATABASE_URL=postgresql://user:password@postgres-users:5432/detect_ai
DATABASE_URL_REPLICA=postgresql://user:password@postgres-users:5432/detect_ai
REDIS_URL=redis://:user_cache_password@redis-users:6379
REDIS_PASSWORD=user_cache_password

# NextAuth
NEXTAUTH_SECRET=change-me-to-a-random-32-char-string
NEXTAUTH_URL=http://localhost:3000

# OAuth (mock values disable providers at runtime; fill in for real logins)
GITHUB_ID=mock-github-client-id-not-configured
GITHUB_SECRET=mock-github-client-secret-not-configured
GOOGLE_ID=mock-google-client-id-not-configured
GOOGLE_SECRET=mock-google-client-secret-not-configured

# Cloudflare Turnstile test keys that always pass (fill in for real keys)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x00000000000000000000AA

# Paddle client token only (server paddle keys owned by gateway/workers)
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=mock-paddle-client-token-not-configured
# Build-time public env (inlined at `next build`; for prod CI fetches from
# SSM /detectai/web/ and passes as --build-arg, see README)
NEXT_PUBLIC_ENV_TYPE=dev

# Backend services (defaults point at the root local stack)
PAYMENT_GATEWAY_URL=http://payment-gateway:8080
INTERNAL_API_KEY=internal-secret-key
AI_SERVICE_URL=ai-service:50051
AI_SERVICE_API_KEY=dev-secret-key
CHAT_SERVICE_URL=chat-service:50051
FILE_EXTRACTOR_API_URL=http://document-parser:8000
# Local standalone broker (infra/docker/rabbitmq/standalone.yml).
# Prod hydrates RABBITMQ_URL from AWS Secret detectai/mq/urls at runtime.
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# Observability (optional; prod via SSM /detectai/web/)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=web
PROMETHEUS_WEB_SCRAPE_TOKEN=

# Prod AWS (only when ENV_TYPE=prod; ignored in dev/preview)
# ENV_TYPE=prod
# AWS_REGION=ap-south-1
# AWS_ENDPOINT_URL=http://host.docker.internal:4566  # Floci / LocalStack
# SSM_PREFIX=/detectai/web/
# WEB_SECRETS_NAME=detectai/web/secrets
# PG_URLS_SECRET_NAME=detectai/pg/urls
# REDIS_URLS_SECRET_NAME=detectai/redis/users/urls
# MQ_URLS_SECRET_NAME=detectai/mq/urls
